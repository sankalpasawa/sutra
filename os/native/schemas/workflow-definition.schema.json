{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sutra://os/native/schemas/workflow-definition.schema.json",
  "title": "workflow-definition (registry entry)",
  "description": "Ratified record shape per SCOPE.md §4 (B18-1, amended by the S0 gate review). Registry entries under ~/.sutra-native/registry/workflows/ validate against this. Step verifies use the same pinned-template reference {template_id, template_version} as the run ledger (G1). Evolution is additive-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "title",
    "goal",
    "steps",
    "failure_policy",
    "reuse_tag",
    "status",
    "proposed_by",
    "approved_by",
    "ts_registered"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "description": "Schema version carried by every row (SCOPE §4 preamble)."
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable workflow identifier, e.g. W-kyc-verify."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of this workflow definition."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "how", "verify"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "how": {
            "type": "string",
            "minLength": 1
          },
          "verify": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template_id", "template_version", "args"],
            "description": "PINNED registry reference — later template edits never change the meaning of old evidence (G1).",
            "properties": {
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "template_version": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": ["string", "number", "boolean", "null"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_budget", "on_escalate"],
      "properties": {
        "retry_budget": {
          "type": "integer",
          "minimum": 0
        },
        "on_escalate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reuse_tag": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "registered", "superseded", "retired"]
    },
    "proposed_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": ["string", "null"],
      "description": "Nullable until approve (SCOPE §4); approve is never automatic (SCOPE §1)."
    },
    "ts_registered": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Nullable until registered."
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["registered", "superseded", "retired"]
          }
        }
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "ts_registered": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
