#!/usr/bin/env bash
# pre-commit wrapper (Sutra submodule) — calls pre-commit-test-gate.
#
# Ported from holding/hooks/git-wrappers/pre-commit pattern. Simpler here
# because Sutra doesn't have the operationalization-check gate yet (will
# propagate in a later ring).
#
# Installed via `git config core.hooksPath hooks/git-wrappers` inside sutra.
#
## Operationalization
#
### 1. Measurement mechanism
# Exit code — 0 = pass, nonzero = commit blocked. Telemetry via pre-commit-test-gate.sh.
#
### 2. Adoption mechanism
# sutra/.git/config sets core.hooksPath = hooks/git-wrappers.
#
### 3. Monitoring / escalation
# If pre-commit doesn't fire, re-check core.hooksPath; re-run
# `git config core.hooksPath hooks/git-wrappers` inside sutra.
#
### 4. Iteration trigger
# New gates added here when pre-commit gains new upstream checks
# (operationalization-check is next candidate once it ports to plugin).
#
### 5. DRI
# CEO of Sutra.
#
### 6. Decommission criteria
# Retire when Sutra plugin ships a shared pre-commit wrapper.

set -euo pipefail
REPO_ROOT=$(git rev-parse --show-toplevel)

# Test gate (D1 — verify before commit)
bash "$REPO_ROOT/hooks/pre-commit-test-gate.sh"

# Hook-path validator (v2.10.0 manifest-vs-source-tree drift guard).
# Closes the regression class behind vinit#43: manifest declared a hook
# whose .sh file was never `git add`'d. Validator reads hooks/hooks.json,
# expands every ${CLAUDE_PLUGIN_ROOT} command, and confirms each path
# exists on disk AND is git-tracked. Skips silently if validator absent
# (e.g. older sutra checkouts pre-v2.10.0).
VALIDATOR="$REPO_ROOT/marketplace/plugin/scripts/validate-hook-paths.sh"
if [ -x "$VALIDATOR" ]; then
  bash "$VALIDATOR"
fi

# Manifest version-sync guard (C13 drift class, 3rd recurrence 2026-08-09).
# Runs the same jq validation the nightly governance audit runs, so
# catalog-vs-source version drift (marketplace.json vs plugin.json) blocks
# at commit time instead of surfacing post-commit in the audit. Known
# limitation: reads working tree, not staged index — a partially staged
# bump can still slip through (follow-up logged in findings ledger).
MANIFEST_TEST="$REPO_ROOT/marketplace/plugin/tests/unit/test-validate-manifest-json.sh"
if [ -f "$MANIFEST_TEST" ]; then
  bash "$MANIFEST_TEST"
fi
