{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "elements": {
      "description": "every interactive element, E1, E2, ... in order (for Flow Pilates Studio, a lld)",
      "items": {
        "$ref": "#/definitions/Element"
      },
      "type": "array"
    },
    "assumptions": {
      "description": "the assumptions of Flow Pilates Studio's Interactive elements",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "facts_used": {
      "description": "the charter facts this section is written from, copied exactly from Flow Pilates Studio's charter",
      "items": {
        "enum": [
          "Flow Pilates Studio",
          "The Interactive elements section is written for Flow Pilates Studio"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "elements"
  ],
  "type": "object",
  "definitions": {
    "Element": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "E1, E2, ... in order",
          "type": "string"
        },
        "section": {
          "description": "the section id it sits in, e.g. \"S1\"",
          "type": "string"
        },
        "selector": {
          "description": "its selector, e.g. \"#book-now\"",
          "type": "string"
        },
        "trigger": {
          "description": "what the visitor does, e.g. \"click\"",
          "type": "string"
        },
        "behaviour": {
          "description": "what happens then",
          "type": "string"
        }
      },
      "required": [
        "id",
        "section",
        "selector",
        "trigger",
        "behaviour"
      ],
      "type": "object"
    }
  }
}
