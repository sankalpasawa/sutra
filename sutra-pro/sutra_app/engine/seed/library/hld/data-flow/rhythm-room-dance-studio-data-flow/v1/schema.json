{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "data_flows": {
      "description": "every flow the pages need, including each form (for Rhythm Room Dance Studio, a hld)",
      "items": {
        "$ref": "#/definitions/DataFlow"
      },
      "type": "array"
    },
    "assumptions": {
      "description": "the assumptions of Rhythm Room Dance Studio's Data flow",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "facts_used": {
      "description": "the charter facts this section is written from, copied exactly from Rhythm Room Dance Studio's charter",
      "items": {
        "enum": [
          "Rhythm Room Dance Studio",
          "The Data flow section is written for Rhythm Room Dance Studio"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "data_flows",
    "assumptions",
    "facts_used"
  ],
  "type": "object",
  "definitions": {
    "DataFlow": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "where the data comes from",
          "type": "string"
        },
        "to": {
          "description": "where it goes",
          "type": "string"
        },
        "data": {
          "description": "what is sent",
          "type": "string"
        },
        "trigger": {
          "description": "what starts it",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "data",
        "trigger"
      ],
      "type": "object"
    }
  }
}
