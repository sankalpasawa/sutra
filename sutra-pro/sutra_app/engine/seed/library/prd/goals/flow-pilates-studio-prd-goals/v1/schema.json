{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "goals": {
      "description": "the goals, G1, G2, ... in order (for Flow Pilates Studio, a prd)",
      "items": {
        "$ref": "#/definitions/Goal"
      },
      "type": "array"
    },
    "assumptions": {
      "description": "the assumptions of Flow Pilates Studio's Goals",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "facts_used": {
      "description": "the charter facts this section is written from, copied exactly from Flow Pilates Studio's charter",
      "items": {
        "enum": [
          "Flow Pilates Studio",
          "Friday 6:30 pm Stretch and Release 550",
          "Monday 7:00 am Mat Basics 500",
          "Payment is made at the studio",
          "Saturday 9:00 am Weekend Mat Class 500",
          "The Goals section lists the goals of showing the weekly classes and taking booking requests",
          "Tuesday 6:30 pm Reformer Flow 800",
          "Unit 3, 9 Sample Lane, Pune 411004",
          "Wednesday 7:00 am Core Strength 600",
          "bookings@flowpilates.example",
          "name, email, class, preferred date"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "goals",
    "assumptions",
    "facts_used"
  ],
  "type": "object",
  "definitions": {
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "G1, G2, ... in order",
          "type": "string"
        },
        "statement": {
          "description": "the goal in one line",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "type": "object"
    }
  }
}
