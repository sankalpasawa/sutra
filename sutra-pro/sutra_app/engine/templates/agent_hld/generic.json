          "required": true,
          "description": "what this design covers and what it leaves out",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [],
      "rules": [
        {
          "rule": "not_empty",
          "path": "purpose",
          "name": "the purpose is given",
          "from": "AH1"
