            {
              "name": "kind",
              "type": "string",
              "required": true,
              "description": "trigger, orchestrator, agent, model_call, tool, store or guardrail",
              "enum": [
                "trigger",
                "orchestrator",
                "agent",
                "model_call",
                "tool",
                "store",
                "guardrail"
              ],
              "nullable": false
            },
            {
              "name": "covers",
              "type": "list[string]",
              "required": false,
              "description": "the agent PRD requirement ids it covers, e.g. [\"R1\"]",
              "nullable": false
            },
            {
              "name": "step",
              "type": "string",
              "required": false,
              "description": "the step id it works in, e.g. \"S2\"",
              "nullable": false
            },
            {
              "name": "action",
              "type": "string",
              "required": false,
              "description": "for a tool: the agent PRD action id it performs, e.g. \"A2\"",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "components",
          "prefix": "C",
          "name": "ids C1, C2, ... unique and in order",
          "from": "AH4"
        },
        {
          "rule": "not_empty",
          "path": "components[].responsibility",
          "name": "every component states its responsibility",
          "from": "AH4"
        },
        {
          "rule": "enum",
          "path": "components[].kind",
          "values": [
            "trigger",
            "orchestrator",
            "agent",
            "model_call",
            "tool",
            "store",
            "guardrail"
          ],
          "name": "kind is one of trigger, orchestrator, agent, model_call, tool, store, guardrail",
          "from": "AH4"
        },
        {
          "rule": "ref_exists",
          "path": "components[].step",
          "target": "this.steps[].id",
          "name": "step points at a step id of this document",
          "from": "AH3"
        },
        {
          "rule": "ref_exists",
          "path": "components[].action",
          "target": "agent_prd.actions[].id",
          "required_target": true,
          "fail_text": "{id} performs {bad}, which is not an action of the agent PRD",
          "missing_text": "{id}: the agent PRD's ids are not recorded, so Performs can't be checked",
          "name": "action points at an action id of the agent PRD",
          "from": "AH5"
        },
        {
          "rule": "ref_exists",
          "path": "components[].covers",
          "target": "agent_prd.requirements[].id",
          "required_target": true,
          "fail_text": "{id} covers {bad}, which is not a requirement of the agent PRD",
          "missing_text": "{id}: the agent PRD's ids are not recorded, so Covers can't be checked",
          "name": "covers points at a requirement id of the agent PRD",
          "from": "AH5"
        }
      ],
      "render": [
        {
          "each": "components",
          "line": "- **{id}** {name} ({kind}): {responsibility:nodot}.[ Covers {covers}.][ In {step}.][ Performs {action}.]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
