    {
      "name": "Agent HLD/1 · Run shape",
      "artifact": "agent_hld",
      "section": "Run shape",
      "version": 1,
      "kind": "generic",
      "description": "The generic Agent HLD/1 · Run shape template: the fixed layout of every Agent HLD Run shape section, whatever the agent",
      "model": "AgentHLDRunShape",
      "conditions": [
        "AH1"
      ],
      "fields": [
        {
          "name": "shape",
          "type": "RunShape",
          "required": true,
          "description": "how much the model controls the run: the first decision of the design",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "RunShape",
          "fields": [
            {
              "name": "level",
              "type": "string",
              "required": true,
              "description": "single_call (one model call), workflow (code fixes the steps, the model fills some), agent (the model picks its next step in a loop), multi_agent (several agents hand work to each other)",
              "enum": [
                "single_call",
                "workflow",
                "agent",
                "multi_agent"
              ],
              "nullable": false
            },
            {
              "name": "pattern",
              "type": "string",
              "required": true,
              "description": "fixed_sequence, classify_and_dispatch, fan_out, dynamic_delegation, generate_and_check or single_loop",
              "enum": [
                "fixed_sequence",
                "classify_and_dispatch",
                "fan_out",
                "dynamic_delegation",
                "generate_and_check",
                "single_loop"
              ],
              "nullable": false
            },
            {
              "name": "why_not_simpler",
              "type": "string",
              "required": true,
              "description": "what the next lower level could not do for this agent; for single_call, why one call is enough",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "enum",
          "path": "shape.level",
          "values": [
            "single_call",
            "workflow",
            "agent",
            "multi_agent"
          ],
          "name": "the level is single_call, workflow, agent or multi_agent",
          "from": "AH1"
        },
        {
          "rule": "enum",
          "path": "shape.pattern",
          "values": [
            "fixed_sequence",
            "classify_and_dispatch",
            "fan_out",
            "dynamic_delegation",
            "generate_and_check",
            "single_loop"
          ],
          "name": "the pattern is one of the six",
          "from": "AH1"
        },
        {
          "rule": "not_empty",
          "path": "shape.why_not_simpler",
          "name": "the design says why nothing simpler works",
          "from": "AH1"
        }
      ],
      "render": [
        {
          "text": "- Level: {shape.level}\n- Pattern: {shape.pattern}\n- Why not simpler: {shape.why_not_simpler}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "Agent HLD/1 · Steps",
      "artifact": "agent_hld",
      "section": "Steps",
      "version": 1,
      "kind": "generic",
      "description": "The generic Agent HLD/1 · Steps template: the fixed layout of every Agent HLD Steps section, whatever the agent",
      "model": "AgentHLDSteps",
      "conditions": [
        "AH1",
        "AH3"
      ],
      "fields": [
        {
          "name": "steps",
          "type": "list[Step]",
          "required": true,
          "description": "the stages of one unit of work, S1, S2, ... in order; for level agent, the phases of its loop (e.g. plan, act, check)",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Step",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "S1, S2, ... in order",
              "nullable": false
            },
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "the step name",
              "nullable": false
            },
            {
              "name": "purpose",
              "type": "string",
              "required": true,
              "description": "what the step does",
              "nullable": false
            },
            {
              "name": "kind",
              "type": "string",
              "required": true,
              "description": "code, model (a model call decides or writes) or human (a person approves or answers)",
              "enum": [
                "code",
                "model",
                "human"
              ],
              "nullable": false
            },
            {
              "name": "implements",
              "type": "list[string]",
              "required": false,
              "description": "the agent PRD requirement ids this step carries",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "steps",
          "prefix": "S",
          "name": "ids S1, S2, ... unique and in order",
          "from": "AH3"
        },
        {
          "rule": "enum",
          "path": "steps[].kind",
          "values": [
            "code",
            "model",
            "human"
          ],
          "name": "kind is code, model or human",
          "from": "AH3"
        },
        {
          "rule": "ref_exists",
          "path": "steps[].implements",
          "target": "agent_prd.requirements[].id",
          "required_target": true,
          "fail_text": "{id} implements {bad}, which is not a requirement of the agent PRD",
          "missing_text": "{id}: the agent PRD's ids are not recorded, so Implements can't be checked",
          "name": "implements points at a requirement id of the agent PRD",
          "from": "AH4"
        }
      ],
      "render": [
        {
          "each": "steps",
          "line": "{#}. **{id}** {name} ({kind}): {purpose:nodot}.[ Implements {implements}.]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
