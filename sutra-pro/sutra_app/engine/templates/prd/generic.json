{
  "schema": "template-library/1",
  "artifact": "prd",
  "kind": "generic",
  "version": 1,
  "from": "hand-edited: this file is the source of this type's sections, their fields, rules and rendering. J2 builds each section's model and checks from it at load time (j2_artifact_models, j2_rules); python3 j2_template_lib.py checks every generic.json",
  "templates": [
    {
      "name": "PRD/1 · Problem",
      "artifact": "prd",
      "section": "Problem",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Problem template: the fixed layout of every PRD Problem section, whatever the business",
      "model": "PRDProblem",
      "conditions": [
        "P1"
      ],
      "fields": [
        {
          "name": "statement",
          "type": "string",
          "required": true,
          "description": "the problem the product solves, in the charter's own words",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "facts you had to assume, each one line",
          "nullable": false
        }
      ],
      "objects": [],
      "rules": [
        {
          "rule": "not_empty",
          "path": "statement",
          "name": "the problem statement is given",
          "from": "P1"
        }
      ],
      "render": [
        {
          "text": "{statement}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Users",
      "artifact": "prd",
      "section": "Users",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Users template: the fixed layout of every PRD Users section, whatever the business",
      "model": "PRDUsers",
      "conditions": [
        "P1",
        "P7"
      ],
      "fields": [
        {
          "name": "users",
          "type": "list[UserGroup]",
          "required": true,
          "description": "every user group the charter names",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "UserGroup",
          "fields": [
            {
              "name": "group",
              "type": "string",
              "required": true,
              "description": "the name of this user group, as the charter names it",
              "nullable": false
            },
            {
              "name": "needs",
              "type": "string",
              "required": false,
              "description": "what this group needs from the product",
              "nullable": false
            },
            {
              "name": "actions",
              "type": "list[string]",
              "required": false,
              "description": "what this group does on the page; empty when this group has no actions in this version",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "not_empty",
          "path": "users[].group",
          "name": "every user group is named",
          "from": "P7"
        },
        {
          "rule": "one_of_present",
          "path": [
            "users[].actions",
            "users[].needs"
          ],
          "name": "every group says what it does or what it needs",
          "from": "P7"
        }
      ],
      "render": [
        {
          "each": "users",
          "line": "- {group}: {needs|uses the page}[; they {actions}]."
        },
        {
          "each": "users",
          "line": "{group:cap} have no actions in this version.",
          "unless": "actions",
          "join": " ",
          "gap": true
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Goals",
      "artifact": "prd",
      "section": "Goals",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Goals template: the fixed layout of every PRD Goals section, whatever the business",
      "model": "PRDGoals",
      "conditions": [
        "P1",
        "P6"
      ],
      "fields": [
        {
          "name": "goals",
          "type": "list[Goal]",
          "required": true,
          "description": "the goals, G1, G2, ... in order",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Goal",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "G1, G2, ... in order",
              "nullable": false
            },
            {
              "name": "statement",
              "type": "string",
              "required": true,
              "description": "the goal in one line",
              "nullable": false
            }
          ]
        }
      ],
      "reply_optional": [
        "goals",
        "assumptions"
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "goals",
          "prefix": "G",
          "name": "ids G1, G2, ... unique and in order",
          "from": "P6"
        }
      ],
      "render": [
        {
          "each": "goals",
          "line": "- **{id}**: {statement}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Requirements",
      "artifact": "prd",
      "section": "Requirements",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Requirements template: the fixed layout of every PRD Requirements section, whatever the business",
      "model": "PRDRequirements",
      "conditions": [
        "P1",
        "P2"
      ],
      "fact_fields": true,
      "fields": [
        {
          "name": "requirements",
          "type": "list[Requirement]",
          "required": true,
          "description": "the requirements, R1, R2, ... in order",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Requirement",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "R1, R2, ... in order",
              "nullable": false
            },
            {
              "name": "statement",
              "type": "string",
              "required": true,
              "description": "what the product must do, naming the user group that does it",
              "nullable": false
            },
            {
              "name": "priority",
              "type": "string",
              "required": true,
              "description": "must, should or could",
              "enum": [
                "must",
                "should",
                "could"
              ],
              "nullable": false
            },
            {
              "name": "goals",
              "type": "list[string]",
              "required": false,
              "description": "the goal ids this requirement serves, e.g. [\"G1\"]",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "requirements",
          "prefix": "R",
          "name": "ids R1, R2, ... unique and in order",
          "from": "P2"
        },
        {
          "rule": "enum",
          "path": "requirements[].priority",
          "values": [
            "must",
            "should",
            "could"
          ],
          "name": "priority is must, should or could",
          "from": "P2"
        },
        {
          "rule": "ref_exists",
          "path": "requirements[].goals",
          "target": "this.goals[].id",
          "name": "goals point at a goal id of this document",
          "from": "P6"
        }
      ],
      "render": [
        {
          "each": "requirements",
          "line": "{#}. **{id}**: {statement:nodot} ({priority|must}).[ Serves {goals}.]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Success metrics",
      "artifact": "prd",
      "section": "Success metrics",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Success metrics template: the fixed layout of every PRD Success metrics section, whatever the business",
      "model": "PRDSuccessMetrics",
      "conditions": [
        "P1",
        "P6",
        "P8"
      ],
      "fields": [
        {
          "name": "success_metrics",
          "type": "list[SuccessMetric]",
          "required": true,
          "description": "one metric per goal",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "SuccessMetric",
          "fields": [
            {
              "name": "goal",
              "type": "string",
              "required": true,
              "description": "the goal id this metric measures, e.g. \"G1\"",
              "nullable": false
            },
            {
              "name": "metric",
              "type": "string",
              "required": true,
              "description": "what is measured",
              "nullable": false
            },
            {
              "name": "target",
              "type": "string",
              "required": false,
              "description": "the number or state to reach",
              "nullable": false
            },
            {
              "name": "window",
              "type": "string",
              "required": false,
              "description": "the measurement window, e.g. \"in the first 30 days\"; write \"measurement window not set\" when the brief doesn't say",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ref_exists",
          "path": "success_metrics[].goal",
          "target": "this.goals[].id",
          "name": "every metric names a goal id of this document",
          "from": "P6"
        }
      ],
      "render": [
        {
          "each": "success_metrics",
          "line": "| {goal} | {metric} | {target|not set} | {window|measurement window not set} |",
          "head": "| Goal | Metric | Target | Window |\n|---|---|---|---|"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Out of scope",
      "artifact": "prd",
      "section": "Out of scope",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Out of scope template: the fixed layout of every PRD Out of scope section, whatever the business",
      "model": "PRDOutOfScope",
      "conditions": [
        "P1"
      ],
      "fields": [
        {
          "name": "out_of_scope",
          "type": "list[string]",
          "required": true,
          "description": "what the product will not do, one line each",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [],
      "reply_optional": [
        "out_of_scope",
        "assumptions"
      ],
      "rules": [
        {
          "rule": "not_empty",
          "path": "out_of_scope",
          "name": "the out-of-scope lines are given",
          "from": "P1"
        }
      ],
      "render": [
        {
          "each": "out_of_scope",
          "line": "- {_}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Document",
      "artifact": "prd",
      "section": "Document",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 document template: the whole PRD as one object, every section in order, as the agent reads it and as the renderer writes it",
      "model": "PRD",
      "fields": [
        {
          "name": "problem",
          "type": "PRDProblem",
          "required": true,
          "description": "",
          "nullable": false
        },
        {
          "name": "users",
          "type": "list[UserGroup]",
          "required": false,
          "description": "",
          "nullable": false
        },
        {
          "name": "goals",
          "type": "list[Goal]",
          "required": false,
          "description": "",
          "nullable": false
        },
        {
          "name": "requirements",
          "type": "list[Requirement]",
          "required": false,
          "description": "",
          "nullable": false
        },
        {
          "name": "success_metrics",
          "type": "list[SuccessMetric]",
          "required": false,
          "description": "",
          "nullable": false
        },
        {
          "name": "out_of_scope",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "reply_optional": [
        "goals",
        "out_of_scope",
        "assumptions",
        "needs",
        "actions",
        "target",
        "window"
      ]
    }
  ]
}
