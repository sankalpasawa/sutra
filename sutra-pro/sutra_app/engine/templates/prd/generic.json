{
  "schema": "template-library/1",
  "artifact": "prd",
  "kind": "generic",
  "version": 1,
  "from": "hand-edited: this file is the source of this type's sections, their fields, rules and rendering. J2 builds each section's model and checks from it at load time (j2_artifact_models, j2_rules); python3 j2_template_lib.py checks every generic.json",
  "assumptions_section": true,
  "templates": [
    {
      "name": "PRD/1 · Problem",
      "artifact": "prd",
      "section": "Problem",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Problem template: the fixed layout of every PRD Problem section, whatever the business",
      "model": "PRDProblem",
      "conditions": [
        "P1"
      ],
      "fields": [
        {
          "name": "statement",
          "type": "string",
          "required": true,
          "description": "the problem the product solves, in the charter's own words",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "facts you had to assume, each one line",
          "nullable": false
        }
      ],
      "objects": [],
      "rules": [
        {
          "rule": "not_empty",
          "path": "statement",
          "name": "the problem statement is given",
          "from": "P1"
        }
      ],
      "render": [
        {
          "text": "{statement}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Users",
      "artifact": "prd",
      "section": "Users",
      "version": 1,
      "kind": "generic",
      "description": "The generic PRD/1 · Users template: the fixed layout of every PRD Users section, whatever the business",
      "model": "PRDUsers",
      "conditions": [
        "P1",
        "P7"
      ],
      "fields": [
        {
          "name": "users",
          "type": "list[UserGroup]",
          "required": true,
          "description": "every user group the charter names",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "UserGroup",
          "fields": [
            {
              "name": "group",
              "type": "string",
              "required": true,
              "description": "the name of this user group, as the charter names it",
              "nullable": false
            },
            {
              "name": "needs",
              "type": "string",
              "required": false,
              "description": "what this group needs, as one sentence in its own voice: \"When <situation>, I want <what>, so that <outcome>\"",
              "nullable": false
            },
            {
              "name": "actions",
              "type": "list[string]",
              "required": false,
              "description": "what this group does with the product; empty when this group has no actions in this version",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "not_empty",
          "path": "users[].group",
          "name": "every user group is named",
          "from": "P7"
        },
        {
          "rule": "one_of_present",
          "path": [
            "users[].actions",
            "users[].needs"
          ],
          "name": "every group says what it does or what it needs",
          "from": "P7"
        }
      ],
      "render": [
        {
          "each": "users",
          "line": "- {group}: {needs|uses the product}[; they {actions}]."
        },
        {
          "each": "users",
          "line": "{group:cap} have no actions in this version.",
          "unless": "actions",
          "join": " ",
          "gap": true
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "PRD/1 · Goals",
      "artifact": "prd",
