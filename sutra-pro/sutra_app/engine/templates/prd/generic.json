              "required": true,
              "description": "G1, G2, ... in order",
              "nullable": false
            },
            {
              "name": "statement",
              "type": "string",
              "required": true,
              "description": "the goal in one line",
              "nullable": false
            }
          ]
        }
      ],
      "reply_optional": [
        "goals",
        "assumptions"
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "goals",
          "prefix": "G",
          "name": "ids G1, G2, ... unique and in order",
          "from": "P6"
        }
      ],
      "render": [
        {
          "each": "goals",
          "line": "- **{id}**: {statement}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
