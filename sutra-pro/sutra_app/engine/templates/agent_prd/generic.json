          "name": "the unit is run, turn or session",
          "from": "AP1"
        },
        {
          "rule": "not_empty",
          "path": "trigger.input",
          "name": "what one unit reads is given",
          "from": "AP1"
        }
      ],
      "render": [
        {
          "text": "- Starts on: {trigger.type}[, {trigger.when}]\n- One unit of work: a {trigger.unit}, reading {trigger.input:nodot}[\n- Already handled: {trigger.already_processed:nodot}][\n- If a unit is still going: {trigger.overlap}][\n- Produces nothing when: {trigger.quiet:nodot}]"
        },
        {
