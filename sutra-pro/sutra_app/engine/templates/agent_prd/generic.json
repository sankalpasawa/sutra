            },
            {
              "name": "input",
              "type": "string",
              "required": true,
              "description": "what one unit reads",
              "nullable": false
            },
            {
              "name": "already_processed",
              "type": "string",
              "required": false,
              "description": "how items handled before are left out of the next unit; \"not applicable\" for a conversation",
              "nullable": false
            },
            {
              "name": "overlap",
              "type": "string",
              "required": false,
              "description": "what happens when a unit starts while the last is still going: skip, queue or run_both",
              "enum": [
                "skip",
                "queue",
                "run_both"
              ],
              "nullable": false
            },
            {
              "name": "quiet",
              "type": "string",
              "required": false,
              "description": "when a unit produces nothing, e.g. \"no new email\"",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "enum",
          "path": "trigger.type",
          "values": [
            "schedule",
            "event",
            "on_demand",
            "conversation"
          ],
          "name": "the trigger type is schedule, event, on_demand or conversation",
          "from": "AP1"
        },
        {
          "rule": "enum",
          "path": "trigger.unit",
          "values": [
            "run",
            "turn",
            "session"
