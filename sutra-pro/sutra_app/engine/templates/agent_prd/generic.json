                "schedule",
                "event",
                "on_demand",
                "conversation"
              ],
              "nullable": false
            },
            {
              "name": "unit",
              "type": "string",
              "required": true,
              "description": "one unit of work: a run, a turn of a conversation, or a whole session",
              "enum": [
                "run",
                "turn",
                "session"
              ],
              "nullable": false
            },
            {
              "name": "when",
              "type": "string",
              "required": false,
              "description": "the schedule (e.g. \"every 15 minutes\") or the event that starts it (e.g. \"a new ticket\")",
