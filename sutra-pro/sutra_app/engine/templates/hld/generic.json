          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Risk",
          "fields": [
            {
              "name": "risk",
              "type": "string",
              "required": true,
              "description": "the risk, one line",
              "nullable": false
            },
            {
              "name": "mitigation",
              "type": "string",
              "required": true,
              "description": "what is done about it",
              "nullable": false
            }
          ]
        }
      ],
      "reply_optional": [
        "risks",
        "assumptions"
      ],
      "rules": [
        {
          "rule": "not_empty",
          "path": [
            "risks[].risk",
            "risks[].mitigation"
          ],
          "name": "every risk has a mitigation",
          "from": "H1"
        }
      ],
      "render": [
        {
          "each": "risks",
          "line": "- {risk:nodot}. Mitigation: {mitigation}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
