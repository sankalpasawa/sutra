          "text": "{hosting.kind}[ {hosting.notes}]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "HLD/1 · Risks",
      "artifact": "hld",
      "section": "Risks",
      "version": 1,
      "kind": "generic",
      "description": "The generic HLD/1 · Risks template: the fixed layout of every HLD Risks section, whatever the business",
      "model": "HLDRisks",
      "conditions": [
