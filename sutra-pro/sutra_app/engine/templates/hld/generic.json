{
  "schema": "template-library/1",
  "artifact": "hld",
  "kind": "generic",
  "version": 1,
  "from": "hand-edited: this file is the source of this type's sections, their fields, rules and rendering. J2 builds each section's model and checks from it at load time (j2_artifact_models, j2_rules); python3 j2_template_lib.py checks every generic.json",
  "templates": [
    {
      "name": "HLD/1 · Purpose and scope",
      "artifact": "hld",
      "section": "Purpose and scope",
      "version": 1,
      "kind": "generic",
      "description": "The generic HLD/1 · Purpose and scope template: the fixed layout of every HLD Purpose and scope section, whatever the business",
      "model": "HLDPurpose",
      "conditions": [
        "H1"
      ],
      "fields": [
        {
          "name": "purpose",
          "type": "string",
          "required": true,
          "description": "what this design covers and what it leaves out",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [],
      "rules": [
        {
          "rule": "not_empty",
          "path": "purpose",
          "name": "the purpose is given",
          "from": "H1"
        }
      ],
      "render": [
        {
          "text": "{purpose}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "HLD/1 · Pages",
      "artifact": "hld",
      "section": "Pages",
      "version": 1,
      "kind": "generic",
      "description": "The generic HLD/1 · Pages template: the fixed layout of every HLD Pages section, whatever the business",
      "model": "HLDPages",
      "conditions": [
        "H1"
      ],
      "fields": [
        {
          "name": "pages",
          "type": "list[Page]",
          "required": true,
          "description": "the pages, P1, P2, ... in order",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Page",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "P1, P2, ... in order",
              "nullable": false
            },
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "the page name",
              "nullable": false
            },
            {
              "name": "purpose",
              "type": "string",
              "required": true,
              "description": "what the page is for",
              "nullable": false
            },
            {
              "name": "implements",
              "type": "list[string]",
              "required": false,
              "description": "the PRD requirement ids this page carries",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "pages",
          "prefix": "P",
          "name": "ids P1, P2, ... unique and in order",
          "from": "H1"
        }
      ],
      "render": [
        {
          "each": "pages",
          "line": "- **{id}** {name}: {purpose:nodot}.[ Implements {implements}.]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "HLD/1 · Components",
      "artifact": "hld",
      "section": "Components",
      "version": 1,
      "kind": "generic",
      "description": "The generic HLD/1 · Components template: the fixed layout of every HLD Components section, whatever the business",
      "model": "HLDComponents",
      "conditions": [
        "H1",
        "H3",
        "H4"
      ],
      "fields": [
        {
          "name": "components",
          "type": "list[Component]",
          "required": true,
          "description": "the components, C1, C2, ... in order; each names the PRD requirement ids it covers",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Component",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "C1, C2, ... in order",
              "nullable": false
            },
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "the component name",
              "nullable": false
            },
            {
              "name": "responsibility",
              "type": "string",
              "required": true,
              "description": "its one responsibility, in one line",
              "nullable": false
            },
            {
              "name": "covers",
              "type": "list[string]",
              "required": false,
              "description": "the PRD requirement ids it covers, e.g. [\"R1\"]",
              "nullable": false
            },
            {
              "name": "page",
              "type": "string",
              "required": false,
              "description": "the page id it sits on, e.g. \"P1\"",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "components",
          "prefix": "C",
          "name": "ids C1, C2, ... unique and in order",
          "from": "H3"
        },
        {
          "rule": "not_empty",
          "path": "components[].responsibility",
          "name": "every component states its responsibility",
          "from": "H3"
        },
        {
          "rule": "ref_exists",
          "path": "components[].page",
          "target": "this.pages[].id",
          "name": "page points at a page id of this document",
          "from": "H1"
        },
        {
          "rule": "ref_exists",
          "path": "components[].covers",
          "target": "prd.requirements[].id",
          "required_target": true,
          "fail_text": "{id} covers {bad}, which is not a requirement of the PRD",
          "missing_text": "{id}: the PRD's requirement ids are not recorded, so Covers can't be checked",
          "name": "covers points at a requirement id of the PRD",
          "from": "H4"
        }
      ],
      "render": [
        {
          "each": "components",
          "line": "- **{id}** {name}: {responsibility:nodot}.[ Covers {covers}.][ On {page}.]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "HLD/1 · Data flow",
      "artifact": "hld",
      "section": "Data flow",
      "version": 1,
      "kind": "generic",
      "description": "The generic HLD/1 · Data flow template: the fixed layout of every HLD Data flow section, whatever the business",
      "model": "HLDDataFlow",
      "conditions": [
        "H1"
      ],
      "fields": [
        {
          "name": "data_flows",
          "type": "list[DataFlow]",
          "required": true,
          "description": "every flow the pages need, including each form",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "DataFlow",
          "fields": [
            {
              "name": "from",
              "type": "string",
              "required": true,
              "description": "where the data comes from",
              "nullable": false
            },
            {
              "name": "to",
              "type": "string",
              "required": true,
              "description": "where it goes",
              "nullable": false
            },
            {
              "name": "data",
              "type": "string",
              "required": true,
              "description": "what is sent",
              "nullable": false
            },
            {
              "name": "trigger",
              "type": "string",
              "required": true,
              "description": "what starts it",
              "nullable": false
            }
          ]
        }
      ],
      "reply_optional": [
        "data_flows",
        "assumptions"
      ],
      "rules": [
        {
          "rule": "not_empty",
          "path": [
            "data_flows[].from",
            "data_flows[].to",
            "data_flows[].data",
            "data_flows[].trigger"
          ],
          "name": "every flow has from, to, data and trigger",
          "from": "H1"
        }
      ],
      "render": [
        {
          "each": "data_flows",
          "line": "- {from} to {to}: {data}, on {trigger}."
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "HLD/1 · Hosting and deployment",
      "artifact": "hld",
      "section": "Hosting and deployment",
      "version": 1,
      "kind": "generic",
      "description": "The generic HLD/1 · Hosting and deployment template: the fixed layout of every HLD Hosting and deployment section, whatever the business",
