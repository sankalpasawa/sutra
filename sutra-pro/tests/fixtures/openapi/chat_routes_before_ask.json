 "paths": {
  "/api/chats/search": {
   "get": {
    "tags": [
     "chats v2"
    ],
    "summary": "Search the chats",
    "operationId": "search_api_chats_search_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 200,
       "default": "",
       "title": "Q"
      }
     },
     {
      "name": "scope",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 80,
       "default": "all",
       "title": "Scope"
      }
     },
     {
      "name": "include",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^archived$"
        },
        {
         "type": "null"
        }
       ],
       "title": "Include"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
