  "/api/chats/{sid}/messages": {
   "get": {
    "tags": [
     "chats"
    ],
    "summary": "The messages of a session, oldest first",
    "operationId": "get_messages_api_chats__sid__messages_get",
    "parameters": [
     {
      "name": "sid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_.:\\-]{1,120}$",
       "title": "Sid"
      }
     },
     {
      "name": "after",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 9007199254740991,
       "minimum": 0,
       "description": "only messages with an id above this",
       "default": 0,
       "title": "After"
      },
      "description": "only messages with an id above this"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 500,
       "minimum": 1,
       "default": 200,
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
