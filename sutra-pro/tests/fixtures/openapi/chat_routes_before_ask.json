 "components": {
  "schemas": {
   "ChoiceIn": {
    "properties": {
     "provider": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^(claude|codex)$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Provider"
     },
     "model": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 100
       },
       {
        "type": "null"
       }
      ],
      "title": "Model"
     },
     "effort": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^(low|medium|high|xhigh|max)$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Effort"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "ChoiceIn"
   },
   "DirectIn": {
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 200000,
      "minLength": 1,
      "title": "Text"
     },
     "attachments": {
      "items": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "type": "array",
      "maxItems": 10,
      "title": "Attachments",
      "default": []
     },
     "names": {
      "items": {
       "type": "string",
       "maxLength": 200
      },
      "type": "array",
      "maxItems": 10,
      "title": "Names",
      "default": []
     },
     "client_id": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,64}$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Client Id"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "text"
    ],
    "title": "DirectIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "RetryIn": {
    "properties": {
     "message_id": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Message Id"
     },
     "client_id": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,64}$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Client Id"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "message_id"
    ],
    "title": "RetryIn"
   },
   "UploadIn": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Name"
     },
     "content_b64": {
      "type": "string",
      "maxLength": 27962034,
      "minLength": 1,
      "title": "Content B64"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "name",
     "content_b64"
    ],
    "title": "UploadIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}
