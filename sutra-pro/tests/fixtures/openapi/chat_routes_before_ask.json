  "/api/chats": {
   "get": {
    "tags": [
     "chats"
    ],
    "summary": "The chat sessions",
    "operationId": "list_chats_api_chats_get",
    "parameters": [
     {
      "name": "node_id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^[A-Za-z0-9_.:\\-]{1,120}$"
        },
        {
         "type": "null"
        }
       ],
       "description": "only the sessions of this node",
       "title": "Node Id"
      },
      "description": "only the sessions of this node"
     },
     {
      "name": "include",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^archived$"
        },
        {
         "type": "null"
        }
       ],
       "description": "archived: add the sessions of merged-away nodes",
       "title": "Include"
      },
      "description": "archived: add the sessions of merged-away nodes"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
