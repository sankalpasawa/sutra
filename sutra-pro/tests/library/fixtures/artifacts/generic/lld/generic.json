      "artifact": "lld",
      "section": "Pages and sections",
      "version": 1,
      "kind": "generic",
      "description": "The generic LLD/1 · Pages and sections template: the fixed layout of every LLD Pages and sections section, whatever the business",
      "fields": [
        {
          "name": "sections",
          "type": "list[LLDSection]",
          "required": true,
          "description": "the page sections, S1, S2, ... in order, each with its anchor and the HLD components it implements",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "LLDSection",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "S1, S2, ... in order",
              "nullable": false
            },
            {
              "name": "anchor",
              "type": "string",
              "required": true,
              "description": "the id attribute on the page, with the #, e.g. \"#classes\"",
              "nullable": false
            },
            {
              "name": "page",
              "type": "string",
              "required": false,
              "description": "the page id, e.g. \"P1\"",
              "nullable": false
            },
            {
              "name": "implements",
              "type": "list[string]",
              "required": false,
              "description": "the HLD component ids this section implements",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "sections",
          "prefix": "S",
          "name": "ids S1, S2, ... unique and in order",
          "from": "L2"
        },
        {
          "rule": "anchor_selector",
          "path": "sections[].anchor",
          "name": "every section has an anchor",
          "from": "L2"
        },
        {
          "rule": "ref_exists",
          "path": "sections[].implements",
          "target": "hld.components[].id",
          "required_target": true,
          "fail_text": "{id} implements {bad}, which is not a component of the HLD",
          "missing_text": "{id}: the HLD's component ids are not recorded, so Implements can't be checked",
          "name": "implements points at a component id of the HLD",
          "from": "L5"
        }
      ],
      "sha": "e01ea3e4ddedf57ff8fbf4ddbda50a44d20491ae7d37fcbbf2139f52c3e89fcb",
