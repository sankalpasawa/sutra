    "artifact": {
      "enum": [
        "prd",
        "hld",
        "lld",
        "design",
        "website"
      ],
      "title": "Artifact",
      "type": "string"
    },
    "sections": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "maxProperties": 40,
      "propertyNames": {
        "maxLength": 80,
        "minLength": 1
      },
      "title": "Sections",
      "type": "object"
    },
    "template": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Template",
      "type": "string"
    },
    "version": {
      "maximum": 999999,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "template",
    "artifact",
    "version",
    "sections"
  ],
  "title": "ArtifactData",
  "type": "object"
}
