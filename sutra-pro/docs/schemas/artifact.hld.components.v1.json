{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "covers": {
          "description": "the PRD requirement ids it covers, e.g. [\"R1\"]",
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Covers",
          "type": "array"
        },
        "id": {
          "description": "C1, C2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "the component name",
          "maxLength": 300,
          "title": "Name",
          "type": "string"
        },
        "page": {
          "default": "",
          "description": "the page id it sits on, e.g. \"P1\"",
          "maxLength": 40,
          "title": "Page",
          "type": "string"
        },
        "responsibility": {
          "description": "its one responsibility, in one line",
          "maxLength": 4000,
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "responsibility"
      ],
      "title": "Component",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "components": {
      "description": "the components, C1, C2, ... in order; each names the PRD requirement ids it covers",
      "items": {
        "$ref": "#/$defs/Component"
      },
      "maxItems": 300,
      "title": "Components",
      "type": "array"
    }
