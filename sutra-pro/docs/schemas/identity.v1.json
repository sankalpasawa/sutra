{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "description": "J2:4317: the Requester's answer to 'run this over its envelope?'. J2 uses `budget_increase` only when approved.",
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "budget_increase": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Increase"
        },
        "kind": {
          "const": "approval",
          "default": "approval",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 600,
          "title": "Reason",
          "type": "string"
        },
        "say": {
          "default": "",
          "maxLength": 4000,
          "title": "Say",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "approved"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalAsk": {
      "additionalProperties": false,
      "description": "J2:4329: Priority asks for approval; Identity may not raise an envelope, so it denies or asks. J2's own mock sends\nASK with no question (J2:4334-4335), so the question is not required.",
      "properties": {
        "clause": {
          "default": "",
          "maxLength": 300,
          "title": "Clause",
          "type": "string"
        },
        "decision": {
          "enum": [
            "DENY",
            "ASK"
          ],
          "title": "Decision",
          "type": "string"
        },
        "kind": {
          "const": "approval_ask",
          "default": "approval_ask",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 600,
          "title": "Reason",
          "type": "string"
        },
        "say": {
          "default": "",
          "maxLength": 4000,
          "title": "Say",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "user_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "decision"
      ],
      "title": "ApprovalAsk",
      "type": "object"
    },
    "DocGoalDraft": {
