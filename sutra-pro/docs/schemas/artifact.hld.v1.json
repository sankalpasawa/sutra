{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "covers": {
          "description": "the PRD requirement ids it covers, e.g. [\"R1\"]",
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Covers",
          "type": "array"
        },
        "id": {
          "description": "C1, C2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "the component name",
          "maxLength": 300,
          "title": "Name",
          "type": "string"
        },
        "page": {
          "default": "",
          "description": "the page id it sits on, e.g. \"P1\"",
          "maxLength": 40,
          "title": "Page",
          "type": "string"
        },
        "responsibility": {
          "description": "its one responsibility, in one line",
          "maxLength": 4000,
          "title": "Responsibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "responsibility"
      ],
      "title": "Component",
      "type": "object"
    },
    "DataFlow": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "description": "what is sent",
          "maxLength": 4000,
          "title": "Data",
          "type": "string"
        },
        "from": {
          "description": "where the data comes from",
          "maxLength": 300,
          "title": "From",
          "type": "string"
        },
        "to": {
          "description": "where it goes",
          "maxLength": 300,
          "title": "To",
          "type": "string"
        },
        "trigger": {
          "description": "what starts it",
          "maxLength": 4000,
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "data",
        "trigger"
      ],
      "title": "DataFlow",
      "type": "object"
    },
    "Hosting": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "how it is hosted, e.g. \"one static file on a static host\"",
          "maxLength": 4000,
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "default": "",
          "description": "how it is deployed and replaced",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Hosting",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "P1, P2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "implements": {
          "description": "the PRD requirement ids this page carries",
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Implements",
          "type": "array"
        },
        "name": {
          "description": "the page name",
          "maxLength": 300,
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "description": "what the page is for",
          "maxLength": 4000,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "purpose"
      ],
      "title": "Page",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "mitigation": {
          "description": "what is done about it",
          "maxLength": 4000,
          "title": "Mitigation",
          "type": "string"
        },
        "risk": {
          "description": "the risk, one line",
          "maxLength": 4000,
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "risk",
        "mitigation"
      ],
      "title": "Risk",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "maxItems": 300,
      "title": "Components",
      "type": "array"
    },
    "data_flows": {
      "items": {
        "$ref": "#/$defs/DataFlow"
      },
      "maxItems": 300,
      "title": "Data Flows",
      "type": "array"
    },
    "hosting": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hosting"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "maxItems": 300,
      "title": "Pages",
      "type": "array"
    },
    "purpose": {
      "default": "",
      "maxLength": 4000,
      "title": "Purpose",
      "type": "string"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Risk"
      },
      "maxItems": 300,
      "title": "Risks",
      "type": "array"
    }
  },
  "title": "HLD",
  "type": "object"
}
