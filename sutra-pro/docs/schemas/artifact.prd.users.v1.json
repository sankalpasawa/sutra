{
  "$defs": {
    "UserGroup": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "description": "what this group does on the page; empty when this group has no actions in this version",
          "items": {
            "maxLength": 4000,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Actions",
          "type": "array"
        },
        "group": {
          "description": "the name of this user group, as the charter names it",
          "maxLength": 300,
          "title": "Group",
          "type": "string"
        },
        "needs": {
          "default": "",
          "description": "what this group needs from the product",
          "maxLength": 4000,
          "title": "Needs",
          "type": "string"
        }
      },
      "required": [
        "group"
      ],
      "title": "UserGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "users": {
      "description": "every user group the charter names",
      "items": {
        "$ref": "#/$defs/UserGroup"
      },
      "maxItems": 300,
      "title": "Users",
      "type": "array"
    }
  },
  "required": [
    "users"
  ],
  "title": "PRDUsers",
  "type": "object"
}
