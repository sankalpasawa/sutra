{
  "$defs": {
    "AIStep": {
      "additionalProperties": false,
      "description": "A work atom done by a model (J2 `how.kind` AI): dispatched as llm or skill.",
      "properties": {
        "atom": {
          "$ref": "#/$defs/AtomDraft"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "ai",
          "default": "ai",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "on_failure": {
          "anyOf": [
            {
              "enum": [
                "rollback",
                "escalate",
                "pause",
                "abort",
                "continue"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Failure"
        }
      },
      "required": [
        "id",
        "name",
        "atom"
      ],
      "title": "AIStep",
      "type": "object"
    },
    "AssignmentStep": {
      "additionalProperties": false,
      "description": "A piece of a request given to one department (the chat agent's refs a1 to a5): its brief, an optional division\nscope, and an earlier task it continues.",
      "properties": {
        "brief": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Brief",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Depends On",
          "type": "array"
        },
        "dept": {
          "pattern": "^[a-z][a-z0-9_-]{1,39}$",
          "title": "Dept",
          "type": "string"
        },
        "follows": {
          "anyOf": [
            {
              "pattern": "^tsk_[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follows"
        },
        "id": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "assignment",
          "default": "assignment",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "on_failure": {
          "anyOf": [
            {
              "enum": [
                "rollback",
                "escalate",
                "pause",
                "abort",
                "continue"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Failure"
        },
        "scope": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{1,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        }
      },
      "required": [
        "id",
        "name",
        "dept",
        "brief"
      ],
      "title": "AssignmentStep",
      "type": "object"
    },
    "AtomDraft": {
      "additionalProperties": false,
      "description": "What the layer declares before the work. A draft is not validated against the plugin's rules: `open_atom` is, and a\ndraft that breaks them becomes a stored refused atom.",
      "properties": {
        "constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "maxItems": 20,
          "title": "Constraints",
          "type": "array"
        },
        "context": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Context",
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AtomEdge"
          },
          "maxItems": 40,
          "title": "Depends On",
          "type": "array"
        },
        "effort": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "expected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExpectedItem"
          },
          "maxItems": 20,
          "title": "Expected",
          "type": "array"
        },
        "goal": {
          "default": "",
          "maxLength": 600,
          "title": "Goal",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "outputs": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Outputs",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^(a-[a-z0-9]{1,16}-[0-9]{2,6}|W-[0-9]+\\.a[0-9]+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "touches": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Touches",
          "type": "array"
        },
        "verify": {
          "$ref": "#/$defs/Verify"
        },
        "work": {
          "$ref": "#/$defs/Work"
        }
      },
      "required": [
        "work"
      ],
      "title": "AtomDraft",
      "type": "object"
    },
    "AtomEdge": {
      "additionalProperties": false,
      "properties": {
        "atom": {
          "maxLength": 40,
          "pattern": "^(a-[a-z0-9]{1,16}-[0-9]{2,6}|W-[0-9]+\\.a[0-9]+)$",
          "title": "Atom",
          "type": "string"
        },
        "why": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "atom",
        "why"
      ],
      "title": "AtomEdge",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One declared check. `text` is the plain sentence people read; `relevance` says why the check tests the goal (None =\nnot given: `open_atom` fills in a default); `results` has one entry per close run.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Args",
          "type": "array"
        },
        "expect": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect"
        },
        "relevance": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "relevance_source": {
          "default": "declared",
          "enum": [
            "declared",
            "default"
          ],
          "title": "Relevance Source",
          "type": "string"
        },
        "results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "maxItems": 3,
          "title": "Results",
          "type": "array"
        },
        "target_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Sha256"
        },
        "template": {
          "enum": [
            "file-exists",
            "grep-count",
            "named-test",
            "element-count",
            "facts-present",
            "tap-targets",
            "behavior-steps",
            "heading-present",
            "section-not-empty",
            "ids-unique",
            "lld-slice",
            "deed-send",
            "reply-valid",
            "turn-posted",
            "charter-stamp",
            "workable",
            "audience-split",
            "atom-rules",
            "judge-gate",
            "price-kept",
            "within-budget",
            "order-registered",
            "finding-per-item",
            "pass-needs-proof",
            "code-measure-wins",
            "answer-recorded"
          ],
          "title": "Template",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 300,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "template"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "description": "What running one check once gave. exit_code 0 passes; 1 fails; 97 a pinned test changed; 127 the runner or CLI\nis missing (or the name is unknown). `attempt` is the close run this belongs to (1 to 3).",
      "properties": {
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "evidence": {
          "default": "",
          "maxLength": 2000,
          "title": "Evidence",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "ts": {
          "minimum": 0,
          "title": "Ts",
          "type": "integer"
        }
      },
      "required": [
        "attempt",
        "exit_code",
        "ts"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CodeStep": {
      "additionalProperties": false,
      "description": "A work atom done by code or by the owner (J2 `how.kind` code; a send deed is a code step, AS:69-75).",
      "properties": {
        "atom": {
          "$ref": "#/$defs/AtomDraft"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "code",
          "default": "code",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "on_failure": {
          "anyOf": [
            {
              "enum": [
                "rollback",
                "escalate",
                "pause",
                "abort",
                "continue"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Failure"
        }
      },
      "required": [
        "id",
        "name",
        "atom"
      ],
      "title": "CodeStep",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "description": "What the work may not do; `check` is an optional sentence a check can use (the plugin sets it to null).",
      "properties": {
        "check": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "description": "What Priority grants a workflow to spend (J2:5190, 166). ROLE:priority also lists proposal_id and valid_until; J2's\ncode has neither, so they are omitted.",
      "properties": {
        "model_call_limit": {
          "default": 2,
          "minimum": 0,
          "title": "Model Call Limit",
          "type": "integer"
        },
        "money_limit": {
          "minimum": 0,
          "title": "Money Limit",
          "type": "integer"
        },
        "retry_limit": {
          "default": 1,
          "minimum": 0,
          "title": "Retry Limit",
          "type": "integer"
        },
        "stop_loss": {
          "default": "",
          "maxLength": 300,
          "title": "Stop Loss",
          "type": "string"
        },
        "time_limit_minutes": {
          "default": 10,
          "minimum": 0,
          "title": "Time Limit Minutes",
          "type": "integer"
        }
      },
      "required": [
        "money_limit"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ExpectedItem": {
      "additionalProperties": false,
      "description": "One thing that must exist when the atom is done (J2's `expected_output`, J2:5128-5129). `heading`, `ids` and `send`\nare the kinds J2's document and deed atoms use; `met` is what J2's code sets after the checks ran.",
      "properties": {
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "section",
            "element",
            "facts",
            "file",
            "test",
            "tap",
            "behavior",
            "heading",
            "ids",
            "send"
          ],
          "title": "Kind",
          "type": "string"
        },
        "met": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Met"
        },
        "steps": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Steps",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            }
          ],
          "title": "Target"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind",
        "target"
      ],
      "title": "ExpectedItem",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "description": "A probe in the experiment zone (JZ:94-135): what is tried, what is watched, when it is dropped, how far it goes.",
      "properties": {
        "fails_if": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Fails If",
          "type": "string"
        },
        "hypothesis": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "limit": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Limit",
          "type": "string"
        },
        "signal": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "hypothesis",
        "signal",
        "fails_if",
        "limit"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ProposedWorkflow": {
      "additionalProperties": false,
      "description": "Adaptation's proposal, or Priority's grant of it (then `envelope` is set). The realization plan fields (RS:56-84)\nappear only when J2_REALIZATION is on.",
      "properties": {
        "approach": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approach"
        },
        "authority_touched": {
          "anyOf": [
            {
              "enum": [
                "local",
                "cross_department",
                "external"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority Touched"
        },
        "capabilities": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Capabilities",
          "type": "array"
        },
        "certainty": {
          "anyOf": [
            {
              "enum": [
                "operate",
                "analyze",
                "experiment",
                "stabilize"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certainty"
        },
        "certainty_signals": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Certainty Signals",
          "type": "array"
        },
        "completion_check": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Completion Check",
          "type": "string"
        },
        "covers": {
          "default": [],
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 60,
          "title": "Covers",
          "type": "array"
        },
        "delivers": {
          "default": [],
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 60,
          "title": "Delivers",
          "type": "array"
        },
        "dependencies": {
          "default": [],
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Dependencies",
          "type": "array"
        },
        "done_test": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Done Test"
        },
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Envelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimated_resources": {
          "$ref": "#/$defs/Resources"
        },
        "expected_outcome": {
          "default": "",
          "maxLength": 400,
          "title": "Expected Outcome",
          "type": "string"
        },
        "experiment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Experiment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failure_policy": {
          "default": "escalate",
          "enum": [
            "rollback",
            "escalate",
            "pause",
            "abort",
            "continue"
          ],
          "title": "Failure Policy",
          "type": "string"
        },
        "fixes": {
          "default": [],
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Fixes",
          "type": "array"
        },
        "goal_gap": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Goal Gap",
          "type": "string"
        },
        "hold": {
          "anyOf": [
            {
              "enum": [
                "waiting_on_identity",
                "waiting_on_dependency"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hold"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "informs": {
          "default": [],
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 60,
          "title": "Informs",
          "type": "array"
        },
        "inputs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Inputs",
          "type": "array"
        },
        "inputs_from": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Inputs From",
          "type": "array"
        },
        "kind": {
          "const": "proposed",
          "default": "proposed",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "output": {
          "default": "website",
          "enum": [
            "website",
            "prd",
            "hld",
            "lld",
            "project"
          ],
          "title": "Output",
          "type": "string"
        },
        "outputs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "parts": {
          "default": [],
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 60,
          "title": "Parts",
          "type": "array"
        },
        "research": {
          "anyOf": [
            {
              "$ref": "#/$defs/Research"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revises": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revises"
        },
        "risks": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Risks",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
