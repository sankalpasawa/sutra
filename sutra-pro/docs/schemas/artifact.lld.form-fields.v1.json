{
  "$defs": {
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "form": {
          "description": "the form's selector, e.g. \"#booking\"",
          "maxLength": 300,
          "title": "Form",
          "type": "string"
        },
        "id": {
          "description": "F1, F2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "the field name attribute",
          "maxLength": 300,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "description": "true when the visitor must fill it in",
          "title": "Required",
          "type": "boolean"
        },
        "section": {
          "default": "",
          "description": "the section id the form sits in, e.g. \"S1\"",
          "maxLength": 40,
          "title": "Section",
          "type": "string"
        },
        "type": {
          "description": "one of text, email, tel, url, number, date, time, select, textarea, checkbox, radio, password, file",
          "enum": [
            "text",
            "email",
            "tel",
            "url",
            "number",
            "date",
            "time",
            "select",
            "textarea",
            "checkbox",
            "radio",
            "password",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "validation": {
          "default": "",
          "description": "the validation rule in one line",
          "maxLength": 4000,
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "form",
        "name",
        "type",
        "required"
      ],
      "title": "FormField",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "form_fields": {
      "description": "every form field, F1, F2, ... in order",
      "items": {
        "$ref": "#/$defs/FormField"
      },
      "maxItems": 300,
      "title": "Form Fields",
      "type": "array"
    }
  },
  "required": [
    "form_fields"
  ],
  "title": "LLDFormFields",
  "type": "object"
}
