{
  "$defs": {
    "FindingRow": {
      "additionalProperties": false,
      "description": "One finding of Audit's reply (J2:9062): exactly one per done-when item, plus one per extra issue.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "criterion": {
          "default": "",
          "maxLength": 1000,
          "title": "Criterion",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "maxLength": 1000,
          "title": "Evidence",
          "type": "string"
        },
        "id": {
          "pattern": "^F-[A-Za-z0-9-]{1,20}$",
          "title": "Id",
          "type": "string"
        },
        "item": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item"
        },
        "needs_requester_fact": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needs Requester Fact"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "verdict": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNING",
            "NEEDS_REVISION",
            "BLOCKED_BY_EVIDENCE",
            "POLICY_CONCERN"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "id",
        "verdict"
      ],
      "title": "FindingRow",
      "type": "object"
    },
    "RubricRow": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "default": "",
          "maxLength": 1000,
          "title": "Evidence",
          "type": "string"
        },
        "id": {
          "pattern": "^[RD]-[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNING",
            "NEEDS_REVISION"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "id",
        "verdict"
      ],
      "title": "RubricRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "J2.g (J2:9062-9072, 9128-9136; ROLE:audit): one finding per done-when item plus one per extra issue, and one rubric\nrow per rubric item. Every finding goes to Identity.",
  "properties": {
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FindingRow"
      },
      "maxItems": 120,
      "title": "Findings",
      "type": "array"
    },
    "kind": {
      "const": "report",
      "default": "report",
      "title": "Kind",
      "type": "string"
    },
    "next": {
      "const": "Identity",
      "title": "Next",
      "type": "string"
    },
    "read": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Read"
    },
    "reason": {
      "default": "",
      "maxLength": 600,
      "title": "Reason",
      "type": "string"
    },
    "rubric": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RubricRow"
      },
      "maxItems": 40,
      "title": "Rubric",
      "type": "array"
    },
    "say": {
      "default": "",
      "maxLength": 4000,
      "title": "Say",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "next"
  ],
  "title": "Report",
  "type": "object"
}
