{
  "$defs": {
    "AutoReuse": {
      "additionalProperties": false,
      "description": "`auto_reuse` of templates.json (J2_AUTO_REUSE=1): the threshold and weights used, the stages asked for, the pick (an id, or\nnull when no template reached the threshold) and every score.",
      "properties": {
        "asked_stages": {
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Asked Stages",
          "type": "array"
        },
        "match": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "picked": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Picked"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/AutoScore"
          },
          "maxItems": 500,
          "title": "Scores",
          "type": "array"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "maxLength": 80
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "threshold",
        "weights",
        "asked_stages"
      ],
      "title": "AutoReuse",
      "type": "object"
    },
    "AutoScore": {
      "additionalProperties": false,
      "description": "One run template scored against a run (J2 `match_run_templates`): the score and its three parts, and whether this run could\ntake it (`eligible`; `why_not` says why not). `mock` is true, false or \"not recorded\".",
      "properties": {
        "business": {
          "title": "Business",
          "type": "number"
        },
        "business_type": {
          "maxLength": 200,
          "title": "Business Type",
          "type": "string"
        },
        "covers": {
          "title": "Covers",
          "type": "number"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "not recorded",
              "type": "string"
            }
          ],
          "title": "Mock"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "stages": {
          "title": "Stages",
          "type": "number"
        },
        "template_stages": {
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Template Stages",
          "type": "array"
        },
        "why_not": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Not"
        }
      },
      "required": [
        "id",
        "name",
        "score",
        "stages",
        "business",
        "covers",
        "template_stages",
        "business_type",
        "mock",
        "eligible"
      ],
      "title": "AutoScore",
      "type": "object"
    },
    "JsonValue": {},
    "RunTemplateUse": {
      "additionalProperties": false,
      "description": "`run_template` of templates.json: the run template this run follows, chosen by the Requester (`set_run_template`) or by\nauto-reuse (`auto`, `match`). `plans` and `workflows` are per-workflow state J2 keeps while the run goes (bounded open JSON).",
      "properties": {
        "added": {
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 500,
          "title": "Added",
          "type": "array"
        },
        "added_stages": {
          "anyOf": [
            {
              "items": {
                "maxLength": 40,
                "type": "string"
              },
              "maxItems": 40,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Added Stages"
        },
        "auto": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auto"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "match": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "of": {
          "maximum": 500,
          "minimum": 0,
          "title": "Of",
          "type": "integer"
        },
        "plans": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Plans",
          "type": "object"
        },
        "selected": {
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 500,
          "title": "Selected",
          "type": "array"
        },
        "workflows": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxItems": 500,
          "title": "Workflows",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "selected",
        "of"
      ],
      "title": "RunTemplateUse",
      "type": "object"
    },
    "TemplateCandidate": {
      "additionalProperties": false,
      "properties": {
        "fingerprint_match": {
          "title": "Fingerprint Match",
          "type": "boolean"
        },
        "has_fields": {
          "title": "Has Fields",
          "type": "boolean"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "version": {
          "maximum": 999999,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version",
        "score",
        "fingerprint_match",
        "has_fields"
      ],
      "title": "TemplateCandidate",
      "type": "object"
    },
    "TemplateDecision": {
      "additionalProperties": false,
      "description": "One routing decision of templates.json. `saved` (J2 33aeeda) is the path of the run's own copy of the template,\nrelative to the run folder (`run_tpl_rel`), or null when the copy could not be made; absent on older runs. The keys\nafter `reason` are those the router adds on some paths only.",
      "properties": {
        "action": {
          "enum": [
            "reused",
            "extended",
            "created",
            "generic"
          ],
          "title": "Action",
          "type": "string"
        },
        "adapted_from": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapted From"
        },
        "artifact": {
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "title": "Artifact",
          "type": "string"
        },
        "atom": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atom"
        },
        "attempts": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempts"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/TemplateCandidate"
          },
          "maxItems": 10,
          "title": "Candidates",
          "type": "array"
        },
        "covers": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covers"
        },
        "door": {
          "anyOf": [
            {
              "enum": [
                "reuse",
                "adapt",
                "build",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Door"
        },
        "facts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Facts"
        },
        "fields": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "first_refused": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Refused"
        },
        "from_template": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Template"
        },
        "kind": {
          "enum": [
            "generic",
            "specialised"
          ],
          "title": "Kind",
          "type": "string"
        },
        "nearest": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearest"
        },
        "nearest_refused": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearest Refused"
        },
        "needed_enums": {
          "additionalProperties": {
            "items": {
              "maxLength": 500,
              "type": "string"
            },
            "maxItems": 300,
            "type": "array"
          },
          "propertyNames": {
            "maxLength": 80
          },
          "title": "Needed Enums",
          "type": "object"
        },
        "needed_fields": {
          "items": {
            "maxLength": 80,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Needed Fields",
          "type": "array"
        },
        "new_family": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Family"
        },
        "reason": {
          "maxLength": 2000,
          "title": "Reason",
          "type": "string"
        },
        "refused": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refused"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "run": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "run_template": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Template"
        },
        "saved": {
          "anyOf": [
            {
              "pattern": "^templates/[a-z0-9-]{1,40}/[a-z0-9-]{1,100}/[a-z0-9-]{1,200}@v[0-9]{1,6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saved"
        },
        "schema_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Sha"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "section": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "t": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T"
        },
        "template": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Template",
          "type": "string"
        },
        "template_workflow": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Workflow"
        },
        "version": {
          "anyOf": [
            {
              "maximum": 999999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "workflow": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        }
      },
      "required": [
        "artifact",
        "section",
        "action",
        "template",
        "kind",
        "reason"
      ],
      "title": "TemplateDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "templates.json of a run. `run_template` and `auto_reuse` appear only when a run template or auto-reuse was in play.",
  "properties": {
    "auto_reuse": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutoReuse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/TemplateDecision"
      },
      "maxItems": 2000,
      "title": "Decisions",
      "type": "array"
    },
    "library": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Library",
      "type": "string"
    },
    "run_template": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunTemplateUse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "library"
  ],
  "title": "TemplatesFile",
  "type": "object"
}
