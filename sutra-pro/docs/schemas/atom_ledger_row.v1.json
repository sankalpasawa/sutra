{
  "$defs": {
    "LedgerVerify": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "template": {
          "enum": [
            "file-exists",
            "grep-count",
            "named-test",
            "element-count",
            "facts-present",
            "tap-targets",
            "behavior-steps",
            "heading-present",
            "section-not-empty",
            "ids-unique",
            "lld-slice",
            "deed-send",
            "reply-valid",
            "turn-posted",
            "charter-stamp",
            "workable",
            "audience-split",
            "atom-rules",
            "judge-gate",
            "price-kept",
            "within-budget",
            "order-registered",
            "finding-per-item",
            "pass-needs-proof",
            "code-measure-wins",
            "answer-recorded"
          ],
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template",
        "exit_code"
      ],
      "title": "LedgerVerify",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One row of the Atom log: the plugin's `atom-ledger-v0.3` plus node_id and department_id; refused and verify_failed\nrows are declared additions to it (S2-models-10, S4-fnodes-08). One row per atom, written when it ends.",
  "properties": {
    "atom_id": {
      "maxLength": 40,
      "pattern": "^(a-[a-z0-9]{1,16}-[0-9]{2,6}|W-[0-9]+\\.a[0-9]+)$",
      "title": "Atom Id",
      "type": "string"
    },
    "attempt": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "department_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{1,39}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Department Id"
    },
    "effort": {
      "anyOf": [
        {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "goal": {
      "default": "",
      "maxLength": 600,
      "title": "Goal",
      "type": "string"
    },
    "kind": {
      "const": "atom_ledger_row",
      "default": "atom_ledger_row",
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "node_id": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "relevance": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance"
    },
    "relevance_source": {
      "anyOf": [
        {
          "enum": [
            "declared",
            "default"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance Source"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "status": {
      "enum": [
        "closed",
        "verify_failed",
        "abandoned",
        "refused"
      ],
      "title": "Status",
      "type": "string"
    },
    "touches": {
      "default": [],
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 40,
      "title": "Touches",
      "type": "array"
    },
    "ts": {
      "minimum": 0,
      "title": "Ts",
      "type": "integer"
    },
    "verify": {
      "anyOf": [
        {
          "$ref": "#/$defs/LedgerVerify"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "atom_id",
    "node_id",
    "status",
    "ts"
  ],
  "title": "LedgerRow",
  "type": "object"
}
