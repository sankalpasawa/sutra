{
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "the file path, e.g. \"index.html\"",
          "maxLength": 300,
          "title": "Path",
          "type": "string"
        },
        "purpose": {
          "description": "what it holds",
          "maxLength": 4000,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "path",
        "purpose"
      ],
      "title": "FileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "files": {
      "description": "every file of the build",
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "maxItems": 1000,
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "files"
  ],
  "title": "LLDFiles",
  "type": "object"
}
