{
  "$defs": {
    "Business": {
      "additionalProperties": false,
      "description": "The business a template version was made for (provenance of a library version, J2 sync 4).",
      "properties": {
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "maxLength": 200,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Business",
      "type": "object"
    },
    "CollectedFrom": {
      "additionalProperties": false,
      "description": "Which run's copy a library version was collected from (the finish step, D142).",
      "properties": {
        "run": {
          "maxLength": 200,
          "title": "Run",
          "type": "string"
        },
        "where": {
          "maxLength": 200,
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "run",
        "where"
      ],
      "title": "CollectedFrom",
      "type": "object"
    },
    "MetaMadeBy": {
      "additionalProperties": false,
      "description": "`made_by` of a library meta.json: the four keys of a spec's `made_by` and, since J2 sync 4, the time it was made.",
      "properties": {
        "agent": {
          "maxLength": 200,
          "title": "Agent",
          "type": "string"
        },
        "atom": {
          "maxLength": 200,
          "title": "Atom",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "run": {
          "maxLength": 200,
          "title": "Run",
          "type": "string"
        },
        "workflow": {
          "maxLength": 200,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "run",
        "workflow",
        "atom",
        "agent"
      ],
      "title": "MetaMadeBy",
      "type": "object"
    },
    "Use": {
      "additionalProperties": false,
      "description": "One use of a template version: who asked for it, and whether it was reused, extended or created.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "atom": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atom"
        },
        "run": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "workflow": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        }
      },
      "title": "Use",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "meta.json of one template version (a library version or a run's copy). A generic copy says `kind: \"generic\"` and\nhas `used_by: []`; a specialised one has no `kind` key in J2, and carries the class name, the creation time and the\nfingerprints of the needs it answered. The keys after `used_by` are provenance: `made_by`, `business`, `mock` and\n`collected_from` (a library version, J2 sync 4; a run's copy of one carries them too) and, from J2 1adb8ecd,\n`renamed_from` (\"name@N\", the family and number a moved version had) and `adapted_from` (\"name@N\", the template an\nauto-reuse adaptation started from).",
  "properties": {
    "adapted_from": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapted From"
    },
    "business": {
      "anyOf": [
        {
          "$ref": "#/$defs/Business"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "class": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Class"
    },
    "collected_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/CollectedFrom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created"
    },
    "fingerprints": {
      "anyOf": [
        {
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 500,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fingerprints"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "generic",
            "specialised"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kind"
    },
    "made_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetaMadeBy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mock": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mock"
    },
    "model_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Sha",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "renamed_from": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Renamed From"
    },
    "schema_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Schema Sha",
      "type": "string"
    },
    "sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha",
      "type": "string"
    },
    "used_by": {
      "items": {
        "$ref": "#/$defs/Use"
      },
      "maxItems": 5000,
      "title": "Used By",
      "type": "array"
    },
    "version": {
      "maximum": 999999,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "version",
    "sha",
    "schema_sha",
    "model_sha"
  ],
  "title": "TemplateMeta",
  "type": "object"
}
