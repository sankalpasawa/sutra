{
  "$defs": {
    "Envelope": {
      "additionalProperties": false,
      "description": "What Priority grants a workflow to spend (J2:5190, 166). ROLE:priority also lists proposal_id and valid_until; J2's\ncode has neither, so they are omitted.",
      "properties": {
        "model_call_limit": {
          "default": 2,
          "minimum": 0,
          "title": "Model Call Limit",
          "type": "integer"
        },
        "money_limit": {
          "minimum": 0,
          "title": "Money Limit",
          "type": "integer"
        },
        "retry_limit": {
          "default": 1,
          "minimum": 0,
          "title": "Retry Limit",
          "type": "integer"
        },
        "stop_loss": {
          "default": "",
          "maxLength": 300,
          "title": "Stop Loss",
          "type": "string"
        },
        "time_limit_minutes": {
          "default": 10,
          "minimum": 0,
          "title": "Time Limit Minutes",
          "type": "integer"
        }
      },
      "required": [
        "money_limit"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "EnvelopeCheck": {
      "additionalProperties": false,
      "description": "J2.c (J2:6920-6921): a run is over its envelope. HOLD it (Coordination carries on) or REQUEST_APPROVAL from Identity.",
      "properties": {
        "decision": {
          "enum": [
            "HOLD",
            "REQUEST_APPROVAL"
          ],
          "title": "Decision",
          "type": "string"
        },
        "kind": {
          "const": "envelope_check",
          "default": "envelope_check",
          "title": "Kind",
          "type": "string"
        },
        "next": {
          "enum": [
            "Coordination",
            "Identity"
          ],
          "title": "Next",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 600,
          "title": "Reason",
          "type": "string"
        },
        "say": {
          "default": "",
          "maxLength": 4000,
          "title": "Say",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "decision",
        "next"
      ],
      "title": "EnvelopeCheck",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "description": "J2.c (J2:6470-6471, 5190-5191, 6476-6481): Priority funds, counters or refuses. A funded workflow carries its\nenvelope with a money limit of at least 1 (J2:6397). P24 (D250): each funded workflow is its id and envelope.",
      "properties": {
        "decision": {
          "enum": [
            "GRANT",
            "COUNTER",
            "REFUSE"
          ],
          "title": "Decision",
          "type": "string"
        },
        "kind": {
          "const": "price",
          "default": "price",
          "title": "Kind",
          "type": "string"
        },
        "next": {
          "enum": [
            "Adaptation",
            "Identity"
          ],
          "title": "Next",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 600,
          "title": "Reason",
          "type": "string"
        },
        "say": {
          "default": "",
          "maxLength": 4000,
          "title": "Say",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "workflows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PricedWorkflow"
          },
          "maxItems": 20,
          "title": "Workflows",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "next"
      ],
      "title": "Price",
      "type": "object"
    },
    "PricedWorkflow": {
      "additionalProperties": false,
      "description": "P24 (D250): one workflow Priority funds, as its move names it: the proposed workflow's id (or its name) and the\nenvelope. The rest of the workflow is Adaptation's proposal.",
      "properties": {
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Envelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "PricedWorkflow",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "envelope_check": "#/$defs/EnvelopeCheck",
      "price": "#/$defs/Price"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Price"
    },
    {
      "$ref": "#/$defs/EnvelopeCheck"
    }
  ]
}
