{
  "$defs": {
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "G1, G2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "description": "the goal in one line",
          "maxLength": 4000,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "Goal",
      "type": "object"
    },
    "PRDProblem": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "description": "facts you had to assume, each one line",
          "items": {
            "maxLength": 4000,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Assumptions",
          "type": "array"
        },
        "statement": {
          "description": "the problem the product solves, in the charter's own words",
          "maxLength": 4000,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement"
      ],
      "title": "PRDProblem",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "goals": {
          "description": "the goal ids this requirement serves, e.g. [\"G1\"]",
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Goals",
          "type": "array"
        },
        "id": {
          "description": "R1, R2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "description": "must, should or could",
          "enum": [
            "must",
            "should",
            "could"
          ],
          "title": "Priority",
          "type": "string"
        },
        "statement": {
          "description": "what the product must do, naming the user group that does it",
          "maxLength": 4000,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "priority"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SuccessMetric": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "description": "the goal id this metric measures, e.g. \"G1\"",
          "maxLength": 40,
          "title": "Goal",
          "type": "string"
        },
        "metric": {
          "description": "what is measured",
          "maxLength": 4000,
          "title": "Metric",
          "type": "string"
        },
        "target": {
          "default": "",
          "description": "the number or state to reach",
          "maxLength": 4000,
          "title": "Target",
          "type": "string"
        },
        "window": {
          "default": "",
          "description": "the measurement window, e.g. \"in the first 30 days\"; write \"measurement window not set\" when the brief doesn't say",
          "maxLength": 4000,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "goal",
        "metric"
      ],
      "title": "SuccessMetric",
      "type": "object"
    },
    "UserGroup": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "description": "what this group does on the page; empty when this group has no actions in this version",
          "items": {
            "maxLength": 4000,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Actions",
          "type": "array"
        },
        "group": {
          "description": "the name of this user group, as the charter names it",
          "maxLength": 300,
          "title": "Group",
          "type": "string"
        },
        "needs": {
          "default": "",
          "description": "what this group needs from the product",
          "maxLength": 4000,
          "title": "Needs",
          "type": "string"
        }
      },
      "required": [
        "group"
      ],
      "title": "UserGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/Goal"
      },
      "maxItems": 300,
      "title": "Goals",
      "type": "array"
    },
    "out_of_scope": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Out Of Scope",
      "type": "array"
    },
    "problem": {
      "$ref": "#/$defs/PRDProblem"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "maxItems": 300,
      "title": "Requirements",
      "type": "array"
    },
    "success_metrics": {
      "items": {
        "$ref": "#/$defs/SuccessMetric"
      },
      "maxItems": 300,
      "title": "Success Metrics",
      "type": "array"
    },
    "users": {
      "items": {
        "$ref": "#/$defs/UserGroup"
      },
      "maxItems": 300,
      "title": "Users",
      "type": "array"
    }
  },
  "required": [
    "problem"
  ],
  "title": "PRD",
  "type": "object"
}
