  "additionalProperties": false,
  "description": "story/1: what each message-board question did, step by step, read from what the run recorded. A run with no board\nhas `has_board: false` and no entries; a run that is not there has `run: null` and `facts` and `flags` empty.",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/StoryEntry"
      },
      "maxItems": 1000,
      "title": "Entries",
      "type": "array"
    },
    "facts": {
      "$ref": "#/$defs/StoryFacts"
    },
    "flags": {
      "$ref": "#/$defs/StoryFlags"
    },
    "has_board": {
      "title": "Has Board",
      "type": "boolean"
    },
    "not_recorded": {
      "items": {
        "maxLength": 2000,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Not Recorded",
      "type": "array"
    },
    "numbers": {
      "$ref": "#/$defs/StoryNumbers"
    },
    "run": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run"
    },
    "schema": {
      "const": "story/1",
      "default": "story/1",
      "title": "Schema",
      "type": "string"
    },
    "steps": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "has_board",
    "entries",
    "numbers",
    "facts",
    "flags",
    "steps",
    "not_recorded"
  ],
  "title": "StoryDoc",
  "type": "object"
