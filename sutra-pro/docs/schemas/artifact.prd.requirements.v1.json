{
  "$defs": {
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "goals": {
          "description": "the goal ids this requirement serves, e.g. [\"G1\"]",
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Goals",
          "type": "array"
        },
        "id": {
          "description": "R1, R2, ... in order",
          "maxLength": 40,
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "description": "must, should or could",
          "enum": [
            "must",
            "should",
            "could"
          ],
          "title": "Priority",
          "type": "string"
        },
        "statement": {
          "description": "what the product must do, naming the user group that does it",
          "maxLength": 4000,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "priority"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Assumptions",
      "type": "array"
    },
    "requirements": {
      "description": "the requirements, R1, R2, ... in order",
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "maxItems": 300,
      "title": "Requirements",
      "type": "array"
    }
  },
  "required": [
    "requirements"
  ],
  "title": "PRDRequirements",
  "type": "object"
