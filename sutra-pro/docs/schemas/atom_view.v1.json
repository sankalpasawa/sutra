          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ViewHow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The atom/1 document (payload `atom_view` v1): the shape J2's page reads, so the J2 UI is unchanged (D6). `stale` and\n`rechecked` are board/1 additions; `wire()` leaves them out when unset, as J2 does.",
