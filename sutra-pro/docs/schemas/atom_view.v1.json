      "title": "AtomEdge",
      "type": "object"
    },
    "JsonValue": {},
    "OutputItem": {
      "additionalProperties": false,
      "description": "What the work produced: `make` gives an artifact, `do` a deed; `form` is an open list (AS:42-55).",
      "properties": {
        "form": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Form",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ref": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "verb": {
          "enum": [
            "make",
            "do"
          ],
          "title": "Verb",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "name",
        "form",
        "ref"
      ],
      "title": "OutputItem",
      "type": "object"
    },
    "ViewCheck": {
      "additionalProperties": false,
