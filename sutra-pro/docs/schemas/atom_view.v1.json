    "id": {
      "maxLength": 40,
      "pattern": "^(a-[a-z0-9]{1,16}-[0-9]{2,6}|W-[0-9]+\\.a[0-9]+)$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 300,
      "title": "Name",
      "type": "string"
    },
    "notes": {
