{
 "kind": "function",
 "description": "drops in on what went live and checks claims against the record",
 "skills": [
  "pick what to check",
  "check the record mechanically",
  "judge a page against the brief"
 ],
 "start": {
  "on": [
   {
    "kind": "version",
    "of": "$deliverable",
    "checked": true
   },
   {
    "kind": "timer",
    "every_s": 86400
   }
  ],
  "unless": [
   "audit.when"
  ]
 },
 "gates": [
  {
   "id": "audit.when",
   "name": "Wait for its time in the period",
   "nature": "decide",
   "born": "C2",
   "code": "audit_when",
   "check": "gate_answer_is_known"
  }
 ],
 "steps": [
  {
   "id": "audit.pick",
   "name": "Pick what to check",
   "nature": "decide",
   "born": "C2",
   "code": "audit_pick",
   "check": "picked_a_sample"
  },
  {
   "id": "audit.mechanical",
   "name": "Check the record",
   "nature": "check",
   "born": "C2",
   "code": "audit_mechanical",
   "check": "has_a_verdict"
  },
  {
   "id": "audit.items",
   "name": "Read each done-when item",
   "nature": "check",
   "born": "C0",
   "ceiling": "C1",
   "only_if": "audit.pick.sample",
   "prompt": "audit_items",
   "draft": "audit_items_draft",
   "out": {
    "items": "list",
    "findings": "list"
   },
   "check": "reading_is_s30"
  },
  {
   "id": "audit.judge",
   "name": "Judge the pages against the brief",
   "nature": "check",
   "born": "C0",
   "ceiling": "C1",
   "only_if": "audit.pick.sample",
   "prompt": "audit_judge",
   "draft": "audit_judge_draft",
   "out": {
    "ok": "bool",
    "findings": "list"
   },
   "check": "findings_name_where_and_what"
  },
  {
   "id": "audit.file",
   "name": "File what it found",
   "nature": "transform",
   "born": "C2",
   "code": "audit_file",
   "check": "spot_check_reads_only"
  }
 ],
 "on": []
}
