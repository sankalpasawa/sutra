    "w.agent_estimate ?? \"\"",
    "w.calls_used||0",
    "w.charged",
    "w.charged === false ? '<br><span class=\"empty\">released</span>' : \"\"",
    "w.cost",
    "w.cost ?? \"?\"",
    "w.cycle",
    "w.id",
    "w.name",
    "w.retries_used || 0",
    "w.retries_used||0",
    "w.status",
    "who(s.write_lock)[0]",
