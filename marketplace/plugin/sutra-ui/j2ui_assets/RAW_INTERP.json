    "xs.map(p => `${p.outcome.first_pass_audit ? \"✓\" : \"✗\"} ${p.outcome.cycles}c/${p.outcome.ai_calls}`).join(\" → \")",
    "y",
    "y + 4",
    "y - 12",
    "y - g",
    "y0",
    "y1",
    "you && back ? \" · \" : \"\"",
