    "tokIn === null ? `not reported${state.mock ? \" (mock mode)\" : \" by this provider\"}; ${calls.reduce((a, c) => a + c.chars.prompt + c.chars.reply, 0).toLocaleString()} characters in and out` : `${tokIn.toLocaleString()} in · ${tokOut.toLocaleString()} out`",
