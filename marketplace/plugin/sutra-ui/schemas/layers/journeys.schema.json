        },
        "drift": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "row": {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              "site": {
                "enum": [
                  "built",
                  "wanted",
                  "today",
                  "open",
                  "directed",
                  "partly",
                  "not_built",
                  "to_build",
                  "none"
                ]
              },
              "state": {
                "enum": [
                  "proven",
                  "partly",
                  "failing",
                  "unproven",
                  "wanted",
                  "dropped",
                  "fault",
                  "unknown",
                  "declared"
                ]
              }
            },
            "required": [
              "row",
              "site",
              "state"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        },
        "id": {
          "maxLength": 6,
          "pattern": "^(J[1-9][0-9]?|S[1-9]|U[1-9]|F(?:I|A|P|C|AU)[1-9])$",
          "type": "string"
        },
        "rows": {
          "additionalProperties": {
            "$ref": "#/$defs/journey.row_status"
          },
          "type": "object"
        },
        "schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "enum": [
            "proven",
            "partly",
            "failing",
            "unproven",
            "wanted",
            "dropped",
            "fault",
            "declared",
            "unknown"
          ]
        },
        "tests": {
          "additionalProperties": {
            "enum": [
              "passed",
              "failed",
              "missing"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "id",
        "definitions_sha",
        "state",
        "counts",
        "tests",
        "rows"
      ],
      "type": "object"
    },
    "journey.step": {
      "additionalProperties": false,
      "properties": {
        "act": {
          "enum": [
            "say",
            "ask",
            "tell",
            "stamp",
            "file",
            "read",
            "run",
            "check",
            "post",
            "decide"
          ]
        },
        "backlog": {
          "anyOf": [
            {
              "maxLength": 6,
              "pattern": "^BL-[1-9][0-9]?[a-z]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "binds": {
          "items": {
            "$ref": "#/$defs/journey.bind"
          },
          "maxItems": 8,
          "minItems": 0,
          "type": "array"
        },
        "branches": {
          "items": {
            "$ref": "#/$defs/journey.branch"
          },
          "maxItems": 6,
          "minItems": 0,
          "type": "array"
        },
        "child": {
          "anyOf": [
            {
              "maxLength": 6,
              "pattern": "^(J[1-9][0-9]?|S[1-9]|U[1-9]|F(?:I|A|P|C|AU)[1-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "items": {
            "maxLength": 80,
            "pattern": "^([A-Za-z_][A-Za-z0-9_]*\\.)?[A-Za-z_$][A-Za-z0-9_$]*$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 0,
          "type": "array"
        },
        "lane": {
          "maxLength": 16,
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "type": "string"
        },
        "n": {
          "maxLength": 3,
          "pattern": "^([0-9]|[1-9][0-9])[a-e]?$",
          "type": "string"
        },
        "read": {
          "type": "boolean"
        },
        "same_as": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^J[1-9][0-9]?/(step/[1-9][0-9]?[a-e]?|edge/J[1-9][0-9]?\\.[1-9][0-9]?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "short": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string",
          "x-say": true
        },
        "site_code": {
          "maxLength": 600,
          "minLength": 0,
          "type": "string",
          "x-say": true
        },
        "site_function": {
          "maxLength": 200,
          "minLength": 0,
          "type": "string",
          "x-say": true
        },
        "site_says": {
          "maxLength": 120,
          "minLength": 0,
          "type": "string",
          "x-say": true
        },
        "site_status": {
          "enum": [
            "built",
            "wanted",
            "today",
            "open",
            "directed",
            "partly",
            "not_built",
            "to_build",
            "none"
          ]
        },
        "tests": {
          "items": {
            "maxLength": 200,
            "pattern": "^(js:[A-Za-z0-9_.-]+\\.js#[A-Za-z0-9_.-]+|[A-Za-z0-9_.-]+\\.py::([A-Za-z_][A-Za-z0-9_]*::)?[A-Za-z_][A-Za-z0-9_]*)$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 0,
          "type": "array"
        },
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "type": "string",
          "x-say": true
        }
      },
      "required": [
        "n",
        "lane",
        "short",
        "text"
      ],
      "type": "object"
    },
    "journey.sub": {
      "additionalProperties": false,
      "properties": {
        "drawn": {
          "maxLength": 120,
          "minLength": 0,
          "type": "string",
          "x-say": true
        },
        "id": {
          "maxLength": 6,
          "pattern": "^J[1-9][0-9]?\\.[a-z]$",
          "type": "string"
        },
        "owner": {
          "maxLength": 80,
          "minLength": 0,
          "type": "string",
          "x-say": true
        },
        "step": {
          "maxLength": 3,
          "pattern": "^([0-9]|[1-9][0-9])[a-e]?$",
          "type": "string"
        },
        "text": {
          "maxLength": 800,
          "minLength": 0,
          "type": "string",
          "x-say": true
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
          "x-say": true
        }
      },
      "required": [
        "id",
        "title",
        "step"
      ],
      "type": "object"
    },
    "journey.was": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/journey.edge"
          },
          "maxItems": 30,
          "minItems": 0,
          "type": "array"
        },
        "lanes": {
          "items": {
            "maxLength": 16,
            "pattern": "^[a-z][a-z0-9_]{0,15}$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 0,
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/journey.step"
          },
          "maxItems": 24,
          "minItems": 0,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
          "x-say": true
        }
      },
      "required": [
        "title",
        "steps",
        "edges"
      ],
      "type": "object"
    }
  },
  "$id": "https://sutra.asawa.co/schemas/layers/journeys.schema.json",
  "$ref": "#/$defs/journey",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user-journey template (level L0): a journey file under journeys/, its parts (lane, step, edge, bind, outcome, sub-journey, ruling, quote, scenario, backlog entry, direction, build row, the earlier rows kept as was) and the status document that is computed for each journey; x-ledger-actions are the ledger words an event bind may name (PRD A3.6). Generated from layer_schema.py (schema version 1); never edited by hand: run `python layer_schema.py --write`.",
  "title": "A user journey",
  "x-ledger-actions": [
    "proposal.requested",
    "proposal.created",
    "proposal.granted",
    "proposal.countered",
    "proposal.refused",
    "proposal.accepted",
    "workflow.validated",
    "workflow.registered",
    "workflow.blocked",
    "timetable.written",
    "envelope.granted",
    "envelope.held",
    "slot.assigned",
    "run.started",
    "run.completed",
    "run.failed",
    "artifact.filed",
    "audit.finding_filed",
    "audit.not_read",
    "identity.assessed",
    "identity.questioned",
    "identity.ruled",
    "conflict.raised",
    "ask.created",
    "ask.answered",
    "goal.reached",
    "cycle.stopped",
    "cycle.resumed",
    "cycle.reopened",
    "goal.revised",
    "check.failed"
  ],
  "x-recognitions": [
    "task",
    "query",
    "directive",
    "feedback",
    "new-idea"
  ]
}
