        "leave",
        "stop",
        "raise"
      ]
    },
    "done_items": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "engine": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "envelope": {
      "by": "identity",
      "lead": null,
      "options": [
        "raise",
