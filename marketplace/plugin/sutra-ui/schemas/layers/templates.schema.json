        "stop"
      ]
    },
    "finding": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "goal": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "hole": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "instructions": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "j2_identity": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "line": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "model": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "publish": {
      "by": "identity",
      "lead": "Publish: go live for the first time",
      "options": []
    },
    "request": {
      "by": "identity",
      "lead": "Your words reach outside the site",
      "options": []
    },
    "rule": {
      "by": "identity",
      "lead": "A rule, as understood",
      "options": []
    },
    "rung": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "setup": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "step": {
      "by": "identity",
      "lead": null,
      "options": []
    },
    "trial": {
      "by": "identity",
      "lead": null,
      "options": []
    }
  },
  "x-levels": [
    {
      "base": "journey",
      "children": "journeys/*.json",
      "keeps": "A journey may add steps, edges, sub-journeys, tests, rulings and quotes. It may not drop, move or re-word a row the site lists (a row leaves only by the owner's mark drop), and it carries no status, which is computed. Every row either binds to code and passing tests, or says it is wanted and names its smallest behaviour.",
      "level": "L0",
      "name": "user journey",
      "rules": [
        "JC-1",
        "JC-2",
        "JC-3",
        "JC-4",
        "JC-5",
        "JC-6",
        "JC-7",
        "JC-8",
        "JC-9",
        "JC-10",
        "JC-11",
        "JC-12"
      ]
    },
    {
      "base": "kind",
      "children": "engine_defs/website.json kinds",
      "keeps": "A kind names its line of work engines, the ones required inside the line, its artifacts, a goal, rules (each tagged), a use case, and a functions_template that every function has.",
      "level": "L1",
      "name": "department kind",
      "rules": [
        "K-1",
        "K-2"
      ]
    },
    {
      "base": "LAYERS",
      "children": "layers/<layer>/v<N>.py; function-templates/<function>/*.json",
      "keeps": "A version places the interface's role phrase, its 'is not' and 'never' lines and the working agreement (its layout holds all eight inputs), supplies every typed word within its limits and uses no banned word. A use-case template adds floor lines and keeps the Default's checks.",
      "level": "L2",
      "name": "function",
      "rules": [
        "FT-1",
        "FT-2",
        "FT-3",
        "FT-4",
        "FT-5",
        "FT-6",
        "FT-7",
        "FT-8",
        "FT-9",
        "FT-10"
      ]
    },
    {
      "base": "engine.library",
      "children": "engine-templates/*.json; the _library of born templates",
      "keeps": "A template names an id, a name, a use case, what it reads and writes (artifacts that have templates), a start (trigger kinds that exist, blockers that are gates) and steps that conform to the step template. A born template adds made_by.",
      "level": "L3",
      "name": "engine and workflow",
      "rules": [
        "E-1",
        "E-2",
        "E-3",
        "E-4"
      ]
    },
    {
      "base": "step",
      "children": "layers/<layer>/v<N>.json; engine-templates/*.json",
      "keeps": "A step has an identity (id, name), a nature, a born rung, a registered check and a body: code, or a prompt with its plain draft and the shape of its answer, or by_hand. A unit starts and ends with a step by code. Ids are unique. Only the free fields change between versions.",
      "level": "L4",
      "name": "step",
      "rules": [
        "ST-1",
        "ST-2",
        "ST-3",
        "ST-4",
        "ST-5",
        "ST-6",
        "ST-7",
        "ST-8",
        "ST-9"
      ]
    },
    {
      "base": "artifact.template",
      "children": "artifact-templates/*.json",
      "keeps": "A template names an id, a name, a kind, a use case, files, checks that exist in artifacts.CHECKS, counts_after (filing or stamp) and operations that are engines.",
      "level": "L5",
      "name": "artifact",
      "rules": [
        "AR-1",
        "AR-2"
      ]
    },
    {
      "base": "identity.ask",
      "children": "ASK_FORMS: one form for each kind of ask",
      "keeps": "An ask has a kind from the list, at most three options each of a known kind, is filed only by Identity to the owner, and has a status from the list.",
      "level": "L6",
      "name": "ask",
      "rules": [
        "AS-1",
        "AS-2"
      ]
    }
  ],
  "x-steps": {
    "ctx": [
