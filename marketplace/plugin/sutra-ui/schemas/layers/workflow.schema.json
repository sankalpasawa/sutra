        "fitted",
        "made"
      ],
      "stages": [
        "proposal",
        "registration",
        "grow"
      ]
    },
    {
      "id": "names_new",
      "says": "no name is one the Library already has",
      "sources": [
        "shaped",
        "made"
      ],
      "stages": [
        "proposal",
        "registration"
      ]
    },
    {
      "id": "first_reads_input",
      "says": "the first engine reads the kind's first artifact",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "proposal",
        "birth",
        "registration"
      ]
    },
    {
      "id": "reads_known",
      "says": "each engine reads the kind's first artifact or what one before it wrote",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "proposal",
        "birth",
        "registration",
        "grow"
      ]
    },
    {
      "id": "one_output",
      "says": "each engine writes something not yet written",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "proposal",
        "birth",
        "registration",
        "grow"
      ]
    },
    {
      "id": "items_covered",
      "says": "every done-when item is covered by an engine",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "registration",
        "proposal"
      ]
    },
    {
      "id": "required_kept",
      "says": "no engine the kind requires is left out",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "proposal",
        "birth",
        "registration"
      ]
    },
    {
      "id": "size_in_range",
      "says": "one engine or more; more than six says why",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "proposal",
        "registration"
      ]
    },
    {
      "id": "check_exists",
      "says": "each engine's output has a check",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "registration",
        "grow"
      ]
    },
    {
      "id": "fits_room",
      "says": "Priority priced it and it fits today's room",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "registration"
      ]
    },
    {
      "id": "line_is_registered",
      "says": "Coordination's line is a registered plan plus the engines the owner added",
      "sources": [
        "library",
        "shaped",
        "fitted",
        "made"
      ],
      "stages": [
        "write"
      ]
    }
  ]
}
