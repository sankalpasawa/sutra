{
  "name": "sutra-desktop",
  "productName": "Sutra",
  "version": "1.0.0",
  "description": "Desktop shell for the Sutra panel. Spawns the FastAPI backend and owns the window.",
  "main": "main.js",
  "private": true,
  "author": "Sutra",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Sutra --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=os.sutra.ui --app-version=1.0.0 --icon=build/Sutra.icns --prune=true"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "@electron/packager": "18.3.6"
  }
}
