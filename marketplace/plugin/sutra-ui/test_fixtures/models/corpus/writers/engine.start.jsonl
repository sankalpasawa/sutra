{"on": [{"kind": "post"}], "unless": []}
{"on": [{"kind": "version", "of": "Pages"}], "unless": ["identity.wait_engine", "identity.gate", "priority.envelope", "coord.chain"]}
{"on": [{"kind": "version", "of": "Brief"}], "unless": ["identity.wait_engine", "identity.gate", "priority.envelope", "coord.chain"]}
