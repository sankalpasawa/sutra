#!/usr/bin/env bash
# sutra-usage — usage-guard helper CLI (founder direction 2026-08-07).
#
# Guards Claude Code rate-limit utilization: warn at >=WARN% (default 70),
# HARD block tool use at >=BLOCK% (default 80) until the founder says
# "continue" (which runs `sutra-usage continue`) or the limit window resets.
#
# DORMANT BY DEFAULT — the hook fires only when ~/.sutra-usage-guard/enabled
# exists. Ships fleet-wide in the plugin (L0) but no client behavior changes
# until that client opts in with `sutra-usage on`.
#
# Commands:
#   on        enable the guard on this machine
#   off       disable the guard
#   status    show utilization, thresholds, override state
#   continue  founder override — allow tool use until the breaching window resets
#   check     (used by usage-guard.sh hook) exit 0 allow / 10 warn / 20 block
#
# Data source: Anthropic OAuth usage endpoint (same data as /usage in the CLI),
# token from macOS keychain "Claude Code-credentials" or ~/.claude/.credentials.json.
# 60s cache; stale cache honored up to 10 min; ANY failure fails OPEN (never
# brick the CLI on a network error).
#
# Test override: SUTRA_USAGE_GUARD_TEST=<pct> forces that utilization.
# Dir override:  SUTRA_USAGE_GUARD_DIR=<dir> (tests use a temp dir).
set -u
CMD="${1:-status}"
GUARD_DIR="${SUTRA_USAGE_GUARD_DIR:-$HOME/.sutra-usage-guard}"
case "$CMD" in
  on)
    mkdir -p "$GUARD_DIR"; chmod 700 "$GUARD_DIR"
    printf 'enabled ts=%s host=%s\n' "$(date +%s)" "$(hostname -s 2>/dev/null || echo unknown)" > "$GUARD_DIR/enabled"
    echo "usage-guard ON — warn>=70%, HARD block>=80% (override: sutra-usage continue)"
    exit 0 ;;
  off)
    rm -f "$GUARD_DIR/enabled"
    echo "usage-guard OFF"
    exit 0 ;;
  status|check|continue) ;;
  *) echo "usage: sutra-usage on|off|status|continue|check" >&2; exit 1 ;;
esac
export SUTRA_USAGE_BIN="$0"
export SUTRA_USAGE_GUARD_DIR="$GUARD_DIR"
exec python3 - "$CMD" <<'PY'
import json, os, subprocess, sys, time
import urllib.request
from datetime import datetime, timezone

cmd = sys.argv[1]
GD = os.environ["SUTRA_USAGE_GUARD_DIR"]
BIN = os.environ.get("SUTRA_USAGE_BIN", "sutra-usage")
os.makedirs(GD, exist_ok=True)
CACHE = os.path.join(GD, "cache.json")
OVERRIDE = os.path.join(GD, "continue-until")
WARN_STAMP = os.path.join(GD, "warn-stamp")

cfg = {"WARN": 70.0, "BLOCK": 80.0, "CACHE_TTL": 60.0, "STALE_MAX": 600.0, "WARN_EVERY": 600.0}
cfgp = os.path.join(GD, "config")
if os.path.exists(cfgp):
    for line in open(cfgp):
        line = line.strip()
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            if k in cfg:
                try:
                    cfg[k] = float(v)
                except ValueError:
                    pass

def _token():
    try:
        raw = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
            capture_output=True, text=True, timeout=5).stdout.strip()
        if raw:
            return json.loads(raw)["claudeAiOauth"]["accessToken"]
    except Exception:
        pass
    try:
        p = os.path.expanduser("~/.claude/.credentials.json")
        return json.load(open(p))["claudeAiOauth"]["accessToken"]
    except Exception:
        return None

def _valid(d):
    return isinstance(d, dict) and (
        isinstance(d.get("five_hour"), dict) or isinstance(d.get("seven_day"), dict))

def _fetch():
    tok = _token()
    if not tok:
        return None
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={"Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20"})
    try:
        with urllib.request.urlopen(req, timeout=4) as r:
            d = json.loads(r.read().decode("utf-8"))
        if not _valid(d):
            return None
        tmp = CACHE + ".tmp." + str(os.getpid())
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.chmod(tmp, 0o600)
        os.replace(tmp, CACHE)
        return d
    except Exception:
        return None

def _cached(max_age):
    try:
        if time.time() - os.path.getmtime(CACHE) <= max_age:
            d = json.load(open(CACHE))
            return d if _valid(d) else None
    except Exception:
        pass
    return None

def _epoch(iso):
    try:
        return datetime.fromisoformat(iso).timestamp()
    except Exception:
        return None

def windows():
    """Return list of (name, pct, reset_epoch). Test env wins. None on no data."""
    test = os.environ.get("SUTRA_USAGE_GUARD_TEST")
    if test:
        try:
            return [("test", float(test), time.time() + 3600)]
        except ValueError:
            return None
    d = _cached(cfg["CACHE_TTL"]) or _fetch() or _cached(cfg["STALE_MAX"])
    if d is None:
        return None
    out = []
    for name in ("five_hour", "seven_day"):
        w = d.get(name) or {}
        u = w.get("utilization")
        if isinstance(u, (int, float)):
            out.append((name, float(u), _epoch(w.get("resets_at") or "") or time.time() + 3600))
    return out or None

def _iso(epoch):
    return datetime.fromtimestamp(epoch, tz=timezone.utc).strftime("%Y-%m-%dT%H:%MZ")

ws = windows()

if cmd == "status":
    enabled = os.path.exists(os.path.join(GD, "enabled"))
    print("usage-guard: %s  (warn>=%d%%, block>=%d%%)" % (
        "ON" if enabled else "OFF", cfg["WARN"], cfg["BLOCK"]))
    if ws is None:
        print("utilization: UNAVAILABLE (no token or fetch failed) -> guard fails open")
    else:
        for name, pct, reset in ws:
            print("  %-10s %3d%%  resets %s" % (name, round(pct), _iso(reset)))
    try:
        until = float(open(OVERRIDE).read().strip())
        if time.time() < until:
            print("override: ACTIVE until %s" % _iso(until))
        else:
            print("override: expired")
    except Exception:
        print("override: none")
    sys.exit(0)

if ws is None:
    if cmd == "continue":
        print("usage-guard: no usage data available; guard is failing open — no override needed")
    sys.exit(0)  # fail open

name, pct, reset = max(ws, key=lambda w: w[1])
breaching = [w for w in ws if w[1] >= cfg["BLOCK"]]
block_reset = max((w[2] for w in breaching), default=reset)

if cmd == "continue":
    if not breaching:
        print("usage-guard: utilization %d%% < block threshold %d%% — not blocked, no override written"
              % (round(pct), cfg["BLOCK"]))
        sys.exit(0)
    tmp = OVERRIDE + ".tmp." + str(os.getpid())
    with open(tmp, "w") as f:
        f.write("%f\n" % block_reset)
    os.chmod(tmp, 0o600)
    os.replace(tmp, OVERRIDE)
    print("usage-guard: founder override ACTIVE until %s (when the %s window resets)"
          % (_iso(block_reset), ", ".join(w[0] for w in breaching)))
    sys.exit(0)

# cmd == check
if pct >= cfg["BLOCK"]:
    try:
        until = float(open(OVERRIDE).read().strip())
        if time.time() < until:
            sys.exit(0)
    except Exception:
        pass
    print("+-- USAGE-GUARD (HARD BLOCK) --------------------------------------+")
    print("| Model utilization %3d%% >= %d%% block threshold (window: %s)" % (round(pct), cfg["BLOCK"], name))
    print("| Window resets: %s" % _iso(block_reset))
    print("| ALL tool use is blocked (founder direction 2026-08-07).")
    print("| Founder: reply \"continue\" to override until the window resets.")
    print("| On \"continue\", Claude runs: bash %s continue" % BIN)
    print("+------------------------------------------------------------------+")
    sys.exit(20)

if pct >= cfg["WARN"]:
    try:
        recent = time.time() - os.path.getmtime(WARN_STAMP) < cfg["WARN_EVERY"]
    except Exception:
        recent = False
    if not recent:
        open(WARN_STAMP, "w").close()
        print("USAGE-GUARD WARNING: model utilization %d%% (window: %s, resets %s). "
              "Hard block at %d%%." % (round(pct), name, _iso(reset), cfg["BLOCK"]))
        sys.exit(10)

sys.exit(0)
PY
