#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""sutra-outbox — durable local outbox (B18-5): add, replay, replay-all, list.

Store: $SUTRA_NATIVE_HOME/outbox/outbox.jsonl (root defaults to
~/.sutra-native). Append-only JSONL — one outbox-row.schema.json object per
line; rows are never edited or deleted. Every write is atomic: full new
content -> temp file in the store dir -> fsync -> os.replace -> directory
fsync. The rename IS the completeness marker: a row is either fully present
or absent, never partial.

State model: append-only, so a state change appends a full new row bearing
the SAME outbox_id with the new state; the current state of an outbox_id is
its LAST row in the file (last-row-wins fold). Idempotency rule: replay of a
non-pending outbox_id is a no-op — exit 0, nothing appended.

THE FENCE (SCOPE section 1 / F7 / B18-5): NOT a scheduler. No cross-device
ordering, no background execution, no retry/backoff policy, no exactly-once,
no dashboards. `list` is a flat last-row-wins view in file order — never a
prioritized queue (F3). Single-operator, single-tenant (F9): no locking, no
cross-tenant paths. Nothing leaves the machine (SCOPE section 6). Instance
data lands only under ~/.sutra-native/ — never the plugin package or
sutra/os/native/schemas/ (SCOPE section 3, CLIs guard).

Exit status (spec: v1-build/specs/outbox.md):
  0  success — including the idempotent no-op replay
  1  row failed structural validation (nothing appended)
  2  usage error
  3  store I/O error (temp write or rename failed; store unchanged)
  4  outbox_id not found (replay)
  6  replay executed and failed — reserved per spec; this build's replay is
     the mark-replayed append itself (no executor in v1), so the only
     failure mode is store I/O (exit 3)
"""

import argparse
import datetime
import getpass
import json
import os
import sys
import tempfile
import uuid

SCHEMA_VERSION = "1.0.0"
REQUIRED = (
    "schema_version",
    "outbox_id",
    "ts_queued",
    "ask_text",
    "operator_id",
    "state",
    "ts_resolved",
    "replay_ref",
)
STATES = ("pending", "replayed", "failed")


def store_root():
    return os.environ.get(
        "SUTRA_NATIVE_HOME", os.path.join(os.path.expanduser("~"), ".sutra-native")
    )


def store_path():
    return os.path.join(store_root(), "outbox", "outbox.jsonl")


def _is_datetime(value):
    if not isinstance(value, str) or not value:
        return False
    try:
        datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
        return True
    except ValueError:
        return False


def validate_row(row):
    """Structural validation mirroring outbox-row.schema.json (stdlib only —
    jsonschema is a forbidden import path in this environment)."""
    if not isinstance(row, dict):
        return ["row is not an object"]
    errs = []
    extra = set(row) - set(REQUIRED)
    if extra:
        errs.append("additionalProperties not allowed: %s" % ", ".join(sorted(extra)))
    for key in REQUIRED:
        if key not in row:
            errs.append("missing required property: %s" % key)
    for key in ("schema_version", "outbox_id", "ask_text", "operator_id"):
        if key in row and (not isinstance(row[key], str) or len(row[key]) < 1):
            errs.append("%s: non-empty string required" % key)
    if "ts_queued" in row and not _is_datetime(row["ts_queued"]):
        errs.append("ts_queued: ISO 8601 date-time string required")
    if "state" in row and row["state"] not in STATES:
        errs.append("state: must be one of %s" % "|".join(STATES))
    if "ts_resolved" in row and row["ts_resolved"] is not None and not _is_datetime(
        row["ts_resolved"]
    ):
        errs.append("ts_resolved: ISO 8601 date-time string or null required")
    if "replay_ref" in row and row["replay_ref"] is not None and not isinstance(
        row["replay_ref"], str
    ):
        errs.append("replay_ref: string or null required")
    return errs


def _now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def _die(code, msg):
    print("sutra-outbox: %s" % msg, file=sys.stderr)
    sys.exit(code)


def load_rows():
    path = store_path()
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except FileNotFoundError:
        return []
    except OSError as e:
        _die(3, "store I/O error: %s" % e)
    rows = []
    for n, line in enumerate(raw.decode("utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except ValueError:
            _die(3, "store parse error at %s line %d (torn row?)" % (path, n))
    return rows


def append_row(row):
    """Validate, then atomically append: existing content + new row -> temp
    file (same dir) -> fsync -> os.replace -> dir fsync. On any I/O failure
    the store is unchanged (exit 3). Nothing is appended on validation
    failure (exit 1)."""
    errs = validate_row(row)
    if errs:
        for e in errs:
            print("sutra-outbox: invalid row: %s" % e, file=sys.stderr)
        sys.exit(1)
    path = store_path()
    d = os.path.dirname(path)
    try:
        os.makedirs(d, exist_ok=True)
        try:
            with open(path, "rb") as f:
                existing = f.read()
        except FileNotFoundError:
            existing = b""
        if existing and not existing.endswith(b"\n"):
            existing += b"\n"
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".outbox.tmp-")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(existing)
                f.write((json.dumps(row, ensure_ascii=False) + "\n").encode("utf-8"))
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
        dfd = os.open(d, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError as e:
        _die(3, "store I/O error: %s" % e)


def fold(rows):
    """Last-row-wins fold: current row per outbox_id, first-appearance file
    order preserved (flat view — no ranking, no due-ness; F3/F7)."""
    current = {}
    for row in rows:
        oid = row.get("outbox_id")
        if isinstance(oid, str) and oid:
            current[oid] = row
    return current


def _default_operator():
    try:
        return getpass.getuser()
    except Exception:
        return "operator"


def _mark_replayed(current_row):
    new = dict(current_row)
    new["state"] = "replayed"
    new["ts_resolved"] = _now()
    new["replay_ref"] = "replay-" + uuid.uuid4().hex[:12]
    append_row(new)
    return new


def cmd_add(args):
    row = {
        "schema_version": SCHEMA_VERSION,
        "outbox_id": str(uuid.uuid4()),
        "ts_queued": _now(),
        "ask_text": args.ask_text,
        "operator_id": args.operator if args.operator is not None else _default_operator(),
        "state": "pending",
        "ts_resolved": None,
        "replay_ref": None,
    }
    append_row(row)
    print(row["outbox_id"])
    return 0


def cmd_replay(args):
    current = fold(load_rows())
    row = current.get(args.outbox_id)
    if row is None:
        _die(4, "outbox_id not found: %s" % args.outbox_id)
    if row.get("state") != "pending":
        # Idempotency rule: replay of an already-resolved outbox_id is a no-op.
        print("no-op: %s already %s" % (args.outbox_id, row.get("state")))
        return 0
    new = _mark_replayed(row)
    print("replayed %s replay_ref=%s" % (args.outbox_id, new["replay_ref"]))
    return 0


def cmd_replay_all(args):
    # Operator-invoked iteration over the current pendings in file order.
    # Not a scheduler: no ordering guarantee, no background execution, no
    # retry on anything non-pending (F7).
    current = fold(load_rows())
    n = 0
    for oid, row in current.items():
        if row.get("state") == "pending":
            new = _mark_replayed(row)
            print("replayed %s replay_ref=%s" % (oid, new["replay_ref"]))
            n += 1
    print("replayed %d pending row(s)" % n)
    return 0


def cmd_list(args):
    current = fold(load_rows())
    for _, row in current.items():
        if args.state and row.get("state") != args.state:
            continue
        print(json.dumps(row, ensure_ascii=False))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="sutra-outbox",
        description="durable local outbox (B18-5): append-only JSONL, atomic "
        "writes, idempotent replay keyed on outbox_id. NOT a scheduler.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_add = sub.add_parser("add", help="queue an ask: append a pending row, print its outbox_id")
    p_add.add_argument("ask_text", help="the ask, verbatim (self-contained; no conversational carry)")
    p_add.add_argument("--operator", metavar="operator_id", default=None, help="operator queuing the ask")

    p_replay = sub.add_parser("replay", help="idempotent replay of one outbox_id (no-op if not pending)")
    p_replay.add_argument("outbox_id")

    sub.add_parser("replay-all", help="replay every currently-pending row, file order")

    p_list = sub.add_parser("list", help="current state per outbox_id (last-row-wins fold; flat, file order)")
    p_list.add_argument("--state", choices=list(STATES), default=None)

    args = parser.parse_args(argv)
    handlers = {
        "add": cmd_add,
        "replay": cmd_replay,
        "replay-all": cmd_replay_all,
        "list": cmd_list,
    }
    return handlers[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
