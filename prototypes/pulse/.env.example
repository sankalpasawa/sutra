# Copy to .env and fill in. A non-empty value set in the shell wins over this file.
# Never commit .env. The key file itself lives outside the repo, mode 600.

# 1 = mock mode (fixture inbox, no Google calls). Unset or 0 = live.
PULSE_MOCK=

# Live only: path to the service-account JSON key, outside the repo.
PULSE_SA_KEY_PATH=

# Live only: the Workspace domain, lowercase, no @ (mock always uses example.test).
PULSE_DOMAIN=

# Live only: allowlist file, one admin-approved mailbox per line (mock uses fixtures/allowlist.txt).
PULSE_ALLOWLIST=

# Output and state folders (created 0700 if missing).
PULSE_OUT_DIR=~/.sutra-pulse/out
PULSE_STATE_DIR=~/.sutra-pulse/state

# Days to keep mail output, 1..3650.
PULSE_RETENTION_DAYS=30

# Mock only: scenario name from fixtures/scenarios.json.
PULSE_MOCK_SCENARIO=default

# 1 = print stack traces on unexpected errors. Never prints config values.
PULSE_DEBUG=
