{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "risks": {
      "description": "each risk with its mitigation (for Rhythm Room Dance Studio, a hld)",
      "items": {
        "$ref": "#/definitions/Risk"
      },
      "type": "array"
    },
    "assumptions": {
      "description": "the assumptions of Rhythm Room Dance Studio's Risks",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "facts_used": {
      "description": "the charter facts this section is written from, copied exactly from Rhythm Room Dance Studio's charter",
      "items": {
        "enum": [
          "Rhythm Room Dance Studio",
          "The Risks section is written for Rhythm Room Dance Studio"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "risks",
    "assumptions",
    "facts_used"
  ],
  "type": "object",
  "definitions": {
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "description": "the risk, one line",
          "type": "string"
        },
        "mitigation": {
          "description": "what is done about it",
          "type": "string"
        }
      },
      "required": [
        "risk",
        "mitigation"
      ],
      "type": "object"
    }
  }
}
