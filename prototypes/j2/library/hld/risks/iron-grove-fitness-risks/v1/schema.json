{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "risks": {
      "description": "each risk with its mitigation (for Iron Grove Fitness, a hld)",
      "items": {
        "$ref": "#/definitions/Risk"
      },
      "type": "array"
    },
    "assumptions": {
      "description": "the assumptions of Iron Grove Fitness's Risks",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "facts_used": {
      "description": "the charter facts this section is written from, copied exactly from Iron Grove Fitness's charter",
      "items": {
        "enum": [
          "Iron Grove Fitness",
          "The Risks section is written for Iron Grove Fitness"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "risks",
    "assumptions",
    "facts_used"
  ],
  "type": "object",
  "definitions": {
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "description": "the risk, one line",
          "type": "string"
        },
        "mitigation": {
          "description": "what is done about it",
          "type": "string"
        }
      },
      "required": [
        "risk",
        "mitigation"
      ],
      "type": "object"
    }
  }
}
