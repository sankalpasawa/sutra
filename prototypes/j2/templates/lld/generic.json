              "nullable": false
            },
            {
              "name": "form",
              "type": "string",
              "required": true,
              "description": "the form's selector, e.g. \"#booking\"",
              "nullable": false
            },
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "the field name attribute",
              "nullable": false
            },
            {
              "name": "type",
              "type": "string",
              "required": true,
              "description": "one of text, email, tel, url, number, date, time, select, textarea, checkbox, radio, password, file",
              "enum": [
                "text",
                "email",
                "tel",
                "url",
                "number",
                "date",
                "time",
                "select",
                "textarea",
                "checkbox",
                "radio",
                "password",
                "file"
              ],
              "nullable": false
            },
            {
              "name": "required",
              "type": "boolean",
              "required": true,
              "description": "true when the visitor must fill it in",
              "nullable": false
            },
            {
              "name": "section",
              "type": "string",
              "required": false,
              "description": "the section id the form sits in, e.g. \"S1\"",
              "nullable": false
            },
            {
              "name": "validation",
              "type": "string",
              "required": false,
              "description": "the validation rule in one line",
              "nullable": false
            }
          ]
        }
      ],
      "reply_optional": [
        "assumptions",
        "validation"
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "form_fields",
          "prefix": "F",
          "name": "ids F1, F2, ... unique and in order",
          "from": "L2"
        },
        {
          "rule": "not_empty",
          "path": [
            "form_fields[].name",
            "form_fields[].type"
          ],
          "name": "every field has a name, a type and a required flag",
          "from": "L4"
        },
        {
          "rule": "enum",
          "path": "form_fields[].type",
          "values": [
            "text",
            "email",
            "tel",
            "url",
            "number",
            "date",
            "time",
            "select",
            "textarea",
            "checkbox",
            "radio",
            "password",
            "file"
          ],
          "name": "type is one of text, email, tel, url, ...",
          "from": "L4"
        },
        {
          "rule": "ref_exists",
          "path": "form_fields[].section",
          "target": "this.sections[].id",
          "name": "section points at a section id of this document",
          "from": "L2"
        }
      ],
      "render": [
        {
          "each": "form_fields",
          "line": "- **{id}** in {section|S1}, form `{form}`: field `{name}`, type {type}, required {required:yesno}[, validation {validation}]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
