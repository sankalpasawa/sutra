{
  "schema": "template-library/1",
  "artifact": "lld",
  "kind": "generic",
  "version": 1,
  "from": "hand-edited: this file is the source of this type's sections, their fields, rules and rendering. J2 builds each section's model and checks from it at load time (j2_artifact_models, j2_rules); python3 j2_template_lib.py checks every generic.json",
 "assumptions_section": true,
  "templates": [
    {
      "name": "LLD/1 · Pages and sections",
      "artifact": "lld",
      "section": "Pages and sections",
      "version": 1,
      "kind": "generic",
      "description": "The generic LLD/1 · Pages and sections template: the fixed layout of every LLD Pages and sections section, whatever the business",
      "model": "LLDSections",
      "conditions": [
        "L1",
        "L2",
        "L5"
      ],
      "fields": [
        {
          "name": "sections",
          "type": "list[LLDSection]",
          "required": true,
          "description": "the page sections, S1, S2, ... in order, each with its anchor and the HLD components it implements",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "LLDSection",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "S1, S2, ... in order",
              "nullable": false
            },
            {
              "name": "anchor",
              "type": "string",
              "required": true,
              "description": "the id attribute on the page, with the #, e.g. \"#classes\"",
              "nullable": false
            },
            {
              "name": "page",
              "type": "string",
              "required": false,
              "description": "the page id, e.g. \"P1\"",
              "nullable": false
            },
            {
              "name": "implements",
              "type": "list[string]",
              "required": false,
              "description": "the HLD component ids this section implements",
              "nullable": false
            }
          ]
        }
      ],
      "reply_optional": [
        "assumptions",
        "anchor",
        "page",
        "implements"
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "sections",
          "prefix": "S",
          "name": "ids S1, S2, ... unique and in order",
          "from": "L2"
        },
        {
          "rule": "anchor_selector",
          "path": "sections[].anchor",
          "name": "every section has an anchor",
          "from": "L2"
        },
        {
          "rule": "ref_exists",
          "path": "sections[].implements",
          "target": "hld.components[].id",
          "required_target": true,
          "fail_text": "{id} implements {bad}, which is not a component of the HLD",
          "missing_text": "{id}: the HLD's component ids are not recorded, so Implements can't be checked",
          "name": "implements points at a component id of the HLD",
          "from": "L5"
        }
      ],
      "render": [
        {
          "each": "sections",
          "line": "- **{id}** `{anchor}`[ (page `{page}`)]: shows {implements|this part of the page}.[ Implements {implements}.]"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "LLD/1 · Interactive elements",
      "artifact": "lld",
      "section": "Interactive elements",
      "version": 1,
      "kind": "generic",
      "description": "The generic LLD/1 · Interactive elements template: the fixed layout of every LLD Interactive elements section, whatever the business",
      "model": "LLDElements",
      "conditions": [
        "L1",
        "L2",
        "L3"
      ],
      "fields": [
        {
          "name": "elements",
          "type": "list[Element]",
          "required": true,
          "description": "every interactive element, E1, E2, ... in order",
          "nullable": false
        },
        {
          "name": "assumptions",
          "type": "list[string]",
          "required": false,
          "description": "",
          "nullable": false
        }
      ],
      "objects": [
        {
          "name": "Element",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "description": "E1, E2, ... in order",
              "nullable": false
            },
            {
              "name": "section",
              "type": "string",
              "required": true,
              "description": "the section id it sits in, e.g. \"S1\"",
              "nullable": false
            },
            {
              "name": "selector",
              "type": "string",
              "required": true,
              "description": "its selector, e.g. \"#book-now\"",
              "nullable": false
            },
            {
              "name": "trigger",
              "type": "string",
              "required": true,
              "description": "what the visitor does, e.g. \"click\"",
              "nullable": false
            },
            {
              "name": "behaviour",
              "type": "string",
              "required": true,
              "description": "what happens then",
              "nullable": false
            }
          ]
        }
      ],
      "rules": [
        {
          "rule": "ids_sequential",
          "path": "elements",
          "prefix": "E",
          "name": "ids E1, E2, ... unique and in order",
          "from": "L2"
        },
        {
          "rule": "not_empty",
          "path": [
            "elements[].selector",
            "elements[].trigger",
            "elements[].behaviour"
          ],
          "name": "every element has a selector, a trigger and a behaviour",
          "from": "L3"
        },
        {
          "rule": "ref_exists",
          "path": "elements[].section",
          "target": "this.sections[].id",
          "name": "section points at a section id of this document",
          "from": "L2"
        }
      ],
      "render": [
        {
          "each": "elements",
          "line": "- **{id}** in {section}: `{selector}` trigger {trigger}; behaviour {behaviour}"
        },
        {
          "each": "assumptions",
          "line": "Assumption: {_}",
          "after_body": true
        }
      ]
    },
    {
      "name": "LLD/1 · Form fields",
      "artifact": "lld",
