{
  "_note": "Artifact types, step 1. j2.py's flow does not read this file; tests/test files compare it with the Python it mirrors (prd/hld/lld/website) and the Artifacts tab reads it. kind type = a deliverable the department builds; kind record = evidence the run keeps. A file with * lists every match. Regexes are case-insensitive.",
  "schema": "artifact-types/1",
  "site_words": "\\b(?:web\\s?)?sites?\\b|\\bweb\\s?pages?\\b|\\blanding\\s+page\\b",
  "groups": {
    "design-docs": {
      "pattern": "\\bdesign\\s+(?:docs?|documents?|documentation)\\b|\\bfull\\s+documentation\\b",
      "members": [
        "prd",
        "hld",
        "lld"
      ]
    }
  },
  "forms": {
    "_note": "How each form is built and checked, defined once. A type names its form; every field it leaves out comes from here ({name}, {label}, {noun} and {sections} are filled from the type). Room for \"script\" and \"action\": not built yet.",
    "page": {"builder": "builder.md", "file": "site/index.html", "preview": "html",
             "check_types": ["file-exists", "grep-count", "element-count", "named-test", "facts-present", "tap-targets", "behavior-steps"], "ready": "Your {lower} is ready."},
    "document": {
      "builder": "templates/document/builder.md", "file": "{name}.md", "preview": "markdown", "export": "docx",
      "check_types": ["facts-present", "heading-present", "section-not-empty"],
      "intake": "templates/document/intake.md", "charter_format": "templates/document/charter.txt",
      "plan": "templates/document/plan.md", "atom_rules": "templates/document/atom_rules.md", "conditions": "document.json",
      "rubric": [
        {"id": "D-1", "text": "Every section does the job its name says, for the charter's audience"},
        {"id": "D-2", "text": "Specific and checkable: names, numbers and rules are stated, not implied"},
        {"id": "D-3", "text": "No invented facts: every fact comes from the brief or the Requester's answers, or is labelled \"Assumption:\"; the evidence quotes each unlabelled claim not in the brief"}
      ],
      "done": "Done: the {label} is workable. Every done-when item, rubric item and necessary condition passes.",
      "ready": "Your document is ready.",
      "cost": {"card": "rates_prd", "section_part": "doc_section"},
      "workflow": {"template": "doc-sections", "refs": "^{name}\\.md(#|$)"},
      "mock": {"charter": "mock_form_charter", "section": "mock_form_section", "atom": {}}
    }
  },
