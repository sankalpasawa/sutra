# Copy to .env and fill in. .env is never committed.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
STUDIO_PROVIDER=
# Owner override: a message starting with this key followed by a command is applied by code
# (budget +N, ship, drop <item>). Pick a long random value. Never shown to agents; redacted in logs and the UI.
J2_OVERRIDE_KEY=
# Seconds one builder (workflow agent) AI call may take before it is stopped and retried once (default 600; 0 = no limit).
J2_BUILDER_TIMEOUT=600
# Seconds between AI calls (default 0). Set 2 on a free-tier key to stay under its rate limits.
# J2_DELAY=2
# Builder tools: on unless J2_AGENT_TOOLS=0. Every builder gets Claude's built-in tools (types.json "builder_tools")
# in its own folder inside the run folder, with the network open and reads fenced to that folder (llm.cli_settings).
# The limits below have these defaults in code (j2.AGENT_DEFAULTS); set one to change it.
# J2_AGENT_TOOLS=1
# Dollars one builder call may spend (claude -p --max-budget-usd; checked after each turn, so one turn may go over).
# J2_AGENT_USD=2.00
# Most files and bytes a builder's folder may hold after a call.
# J2_AGENT_MAX_FILES=200
# J2_AGENT_MAX_BYTES=5000000
# Longest string kept as text in a call's tool log; a longer one is kept as its length and sha256.
# J2_TOOL_LOG_CHARS=2000
# Command that reruns a builder's test inside the sandbox runtime. J2 never runs a builder's code any other way.
# Install: npm install -g @anthropic-ai/sandbox-runtime@0.0.81 (Node 22.12+; Linux also needs bubblewrap, socat and
# ripgrep).
# J2_SANDBOX_CMD=srt
