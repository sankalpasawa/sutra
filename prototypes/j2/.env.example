# Copy to .env and fill in. .env is never committed.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
STUDIO_PROVIDER=
# Owner override: a message starting with this key followed by a command is applied by code
# (budget +N, ship, drop <item>). Pick a long random value. Never shown to agents; redacted in logs and the UI.
J2_OVERRIDE_KEY=
# Seconds one builder (workflow agent) AI call may take before it is stopped and retried once (default 600; 0 = no limit).
J2_BUILDER_TIMEOUT=600
