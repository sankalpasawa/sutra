.DS_Store
node_modules/

# Exception: connectors module ships production runtime deps (yaml, cockatiel,
# nanoid; ~2.2 MB) committed so /plugin install + /plugin update both deliver
# a fully-working stack without npm install. See connectors/.gitignore for
# the full rationale.
!marketplace/plugin/connectors/node_modules/
!marketplace/plugin/connectors/node_modules/**

# Python bytecode. lib/ gained an importable module (org_import.py) and a test
# suite, so running either now leaves __pycache__ directories in the tree.
__pycache__/
*.pyc
