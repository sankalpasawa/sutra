.DS_Store
node_modules/

# Exception: connectors module ships production runtime deps (yaml, cockatiel,
# nanoid; ~2.2 MB) committed so /plugin install + /plugin update both deliver
# a fully-working stack without npm install. See connectors/.gitignore for
# the full rationale.
!marketplace/plugin/connectors/node_modules/
!marketplace/plugin/connectors/node_modules/**

# Python bytecode. lib/ gained an importable module (org_import.py) and a test
# suite, so running either now leaves __pycache__ directories in the tree.
__pycache__/
*.pyc

# Signing material. NEVER commit: the Developer ID private key IS the identity,
# and the App Store Connect .p8 authorises notarization submissions.
# These live in ~/.sutra-signing (mode 600), outside the repo, on purpose.
*.p8
*.p12
*.certSigningRequest

# Per-session governance markers and ledgers, written by the plugin's own
# hooks on every tool call (flow-gate, dispatch-gate, placement, marker-lib).
# Per-machine runtime state, regenerated on demand, and never read from git:
# org_api's _read_jsonl_tail returns (0, [], False) for a missing ledger, and
# every test that touches these paths builds its own sandbox with a synthetic
# session id (mktemp + CLAUDE_PROJECT_DIR), so none reads the repo's copies.
#
# NOTE: files already tracked under these paths STAY tracked -- .gitignore
# does not untrack. These rules only stop NEW artifacts from accumulating.
.claude/sessions/
.claude/flow-inner
**/.enforcement/flow-journal/
**/.enforcement/atom-gate.jsonl
**/.enforcement/dispatch-gate.jsonl
**/.enforcement/marker-contamination.jsonl
**/.enforcement/pytest-isolation-guard.jsonl
**/.enforcement/placement/gate-log.jsonl
